+    /// Bezoek ingesloten objecten met hun UTF-16-positie zonder tekst te kopiëren.
+    fn visit_utf16_embeds<T,F>(&self, _txn: &T, mut visit: F)
+    where T: ReadTxn, F: FnMut(u32,Out)->bool {
+        let mut offset=0u32;
+        let mut n=self.as_ref().start;
+        while let Some(item)=n.as_deref() {
+            if !item.is_deleted() {
+                match &item.content {
+                    ItemContent::String(s)=>offset+=s.len(OffsetKind::Utf16) as u32,
+                    ItemContent::Type(_)|ItemContent::Embed(_)=>{
+                        if let Some(value)=item.content.get_first(){
+                            let len=match &value{Out::Any(Any::String(s))=>s.encode_utf16().count() as u32,_=>1};
+                            if !matches!(&value,Out::Any(Any::String(_))) && !visit(offset,value){return;}
+                            offset+=len;
+                        }
+                    }
+                    _=>{}
+                }
+            }
+            n=item.right;
+        }
+    }
