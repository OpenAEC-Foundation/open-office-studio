@@ -0,0 +1,6 @@
+use std::{cell::RefCell,collections::BTreeMap,time::{Instant,Duration}};
+thread_local!{static TIJDEN:RefCell<BTreeMap<&'static str,(u64,Duration)>>=RefCell::new(BTreeMap::new());}
+pub(crate) struct Meting { naam:&'static str,begin:Instant }
+pub(crate) fn begin(naam:&'static str)->Meting{Meting{naam,begin:Instant::now()}}
+impl Drop for Meting{fn drop(&mut self){TIJDEN.with(|t|{let mut t=t.borrow_mut();let e=t.entry(self.naam).or_default();e.0+=1;e.1+=self.begin.elapsed();});}}
+pub(crate) fn toon(){TIJDEN.with(|t|for(n,(c,d))in t.borrow().iter(){eprintln!("METING {n} {c} {}",d.as_millis());});}
