+fn bewaar_lege_opmaak(naam: &str, bytes: &[u8]) {
+    if let Some(map) = std::env::var_os("OFFICE_TEST_UITVOER") {
+        std::fs::create_dir_all(&map).unwrap();
+        std::fs::write(std::path::PathBuf::from(map).join(naam), bytes).unwrap();
+    }
+}
