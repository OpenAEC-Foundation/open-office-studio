diff --git a/native/crates/office-core/src/celtekst.rs b/native/crates/office-core/src/celtekst.rs
new file mode 100644
index 0000000..f9ee62a
--- /dev/null
+++ b/native/crates/office-core/src/celtekst.rs
@@ -0,0 +1,227 @@
+//! Platte celtekst met tabgescheiden velden, geciteerde regels en expliciete grenzen.
+pub const MAX_CELLEN: usize = 10_000;
+pub const MAX_BYTES: usize = 4 * 1024 * 1024;
+fn ongeldige_xmltekst(tekst: &str) -> bool {
+    tekst.chars().any(|c| {
+        (c < ' ' && !matches!(c, '\t' | '\n' | '\r')) || matches!(c, '\u{fffe}' | '\u{ffff}')
+    })
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CelTekst {
+    rijen: Vec<Vec<String>>,
+}
+impl CelTekst {
+    pub fn nieuw(mut rijen: Vec<Vec<String>>) -> Result<Self, String> {
+        let breedte = rijen.iter().map(Vec::len).max().unwrap_or(0);
+        if breedte == 0
+            || rijen
+                .len()
+                .checked_mul(breedte)
+                .is_none_or(|n| n > MAX_CELLEN)
+        {
+            return Err("Het klembordbereik moet 1 tot 10.000 cellen bevatten".into());
+        }
+        let mut bytes = 0usize;
+        for rij in &mut rijen {
+            for cel in rij.iter() {
+                bytes = bytes.saturating_add(cel.len());
+                if bytes > MAX_BYTES || ongeldige_xmltekst(cel) {
+                    return Err("De celtekst is te groot of bevat ongeldige XML-tekens".into());
+                }
+            }
+            rij.resize(breedte, String::new());
+        }
+        Ok(Self { rijen })
+    }
+    pub fn rijen(&self) -> &[Vec<String>] {
+        &self.rijen
+    }
+    pub fn hoogte(&self) -> usize {
+        self.rijen.len()
+    }
+    pub fn breedte(&self) -> usize {
+        self.rijen[0].len()
+    }
+    pub fn lees(tekst: &str) -> Result<Self, String> {
+        if tekst.len() > MAX_BYTES || ongeldige_xmltekst(tekst) {
+            return Err("De klembordtekst is te groot of bevat ongeldige XML-tekens".into());
+        }
+        let mut rijen = Vec::new();
+        let mut breedte = 0usize;
+        let mut rij = Vec::new();
+        let mut veld = String::new();
+        let mut tekens = tekst.chars().peekable();
+        let (mut begin, mut geciteerd, mut gesloten, mut eindregel) = (true, false, false, false);
+        while let Some(c) = tekens.next() {
+            eindregel = false;
+            if geciteerd {
+                if c == '"' {
+                    if tekens.peek() == Some(&'"') {
+                        tekens.next();
+                        veld.push('"');
+                    } else {
+                        geciteerd = false;
+                        gesloten = true;
+                    }
+                } else {
+                    veld.push(c);
+                }
+                continue;
+            }
+            if c == '"' && begin {
+                begin = false;
+                geciteerd = true;
+                continue;
+            }
+            if c == '\t' || c == '\n' || c == '\r' {
+                rij.push(std::mem::take(&mut veld));
+                breedte = breedte.max(rij.len());
+                if breedte
+                    .checked_mul(rijen.len() + 1)
+                    .is_none_or(|n| n > MAX_CELLEN)
+                {
+                    return Err("Het rechthoekige klembordbereik bevat te veel cellen".into());
+                }
+                begin = true;
+                gesloten = false;
+                if c != '\t' {
+                    if c == '\r' && tekens.peek() == Some(&'\n') {
+                        tekens.next();
+                    }
+                    rijen.push(std::mem::take(&mut rij));
+                    if rijen.len() > MAX_CELLEN {
+                        return Err("Te veel klembordrijen".into());
+                    }
+                    eindregel = true;
+                }
+            } else {
+                if gesloten {
+                    return Err("Onverwachte tekst na een geciteerd celveld".into());
+                }
+                begin = false;
+                veld.push(c);
+            }
+        }
+        if geciteerd {
+            return Err("Een geciteerd celveld is niet afgesloten".into());
+        }
+        if !eindregel || rijen.is_empty() {
+            rij.push(veld);
+            rijen.push(rij);
+        }
+        Self::nieuw(rijen)
+    }
+    pub fn schrijf(&self) -> Result<String, String> {
+        let mut uit = String::new();
+        for (r, rij) in self.rijen.iter().enumerate() {
+            if r > 0 {
+                uit.push_str("\r\n");
+            }
+            for (k, cel) in rij.iter().enumerate() {
+                if k > 0 {
+                    uit.push('\t');
+                }
+                if cel.is_empty() || cel.contains(['\t', '\n', '\r', '"']) {
+                    uit.push('"');
+                    for c in cel.chars() {
+                        uit.push(c);
+                        if c == '"' {
+                            uit.push('"');
+                        }
+                    }
+                    uit.push('"');
+                } else {
+                    uit.push_str(cel);
+                }
+                if uit.len() > MAX_BYTES {
+                    return Err("De geschreven klembordtekst is te groot".into());
+                }
+            }
+        }
+        Ok(uit)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn celtekst_geleende_tabellen_citaten_unicode_en_lege_randen() {
+        let t = CelTekst::lees(
+            "café\t\"regel één\nregel twee\"\t\"\"\r\n\"een \"\"citaat\"\"\"\t🏠\t\r\n",
+        )
+        .unwrap();
+        assert_eq!(
+            t.rijen(),
+            &[
+                vec![
+                    "café".to_string(),
+                    "regel één\nregel twee".into(),
+                    "".into()
+                ],
+                vec!["een \"citaat\"".into(), "🏠".into(), "".into()]
+            ]
+        );
+        assert_eq!(CelTekst::lees(&t.schrijf().unwrap()).unwrap(), t);
+        assert_eq!(
+            CelTekst::lees("a\tb\n1").unwrap().rijen(),
+            &[
+                vec!["a".to_string(), "b".into()],
+                vec!["1".into(), "".into()]
+            ]
+        );
+        assert_eq!(CelTekst::lees("\n\n").unwrap().hoogte(), 2);
+        assert_eq!(CelTekst::lees("a\t").unwrap().breedte(), 2);
+        assert_eq!(CelTekst::lees("").unwrap().rijen(), &[vec![String::new()]]);
+        for rijen in [
+            vec![vec!["a".into()], vec![String::new()]],
+            vec![vec![String::new()], vec![String::new()]],
+            vec![vec![String::new(); 2]; 2],
+        ] {
+            let t = CelTekst::nieuw(rijen).unwrap();
+            assert_eq!(
+                CelTekst::lees(&t.schrijf().unwrap()).unwrap(),
+                t,
+                "Lege laatste rij moet behouden blijven"
+            );
+        }
+    }
+    #[test]
+    fn celtekst_onvolledige_quotes_nultekens_en_rechthoekbudget_worden_geweigerd() {
+        for s in ["\"onafgesloten", "\"klaar\"erachter", "tekst\0rest"] {
+            assert!(CelTekst::lees(s).is_err(), "{s:?}");
+        }
+        assert!(CelTekst::lees(&"a".repeat(MAX_BYTES + 1)).is_err());
+        assert!(CelTekst::nieuw(vec![vec![String::new(); 100]; 101]).is_err());
+        assert!(CelTekst::nieuw(vec![vec![String::new(); 100]; 100]).is_ok());
+        assert!(CelTekst::nieuw(vec![]).is_err());
+        assert!(CelTekst::lees(&format!("{}\n{}", "x\t".repeat(100), "\n".repeat(100))).is_err());
+        let t = CelTekst::nieuw(vec![vec!["\"".repeat(MAX_BYTES)]]).unwrap();
+        assert!(t.schrijf().is_err());
+    }
+}
+
+#[cfg(test)]
+mod aanvullende_proeven {
+    use super::*;
+    #[test]
+    fn xmltekens_en_rechthoekbudget_worden_voor_opslaan_gecontroleerd() {
+        for t in [
+            "a\0b",
+            "a\u{1}b",
+            "a\u{b}b",
+            "a\u{c}b",
+            "a\u{1f}b",
+            "a\u{fffe}b",
+            "a\u{ffff}b",
+        ] {
+            assert!(CelTekst::lees(t).is_err());
+            assert!(CelTekst::nieuw(vec![vec![t.into()]]).is_err());
+        }
+        let geldig = CelTekst::lees("\"regel\r\nregel\"\t\"🏠\twaarde\"").unwrap();
+        assert_eq!(CelTekst::lees(&geldig.schrijf().unwrap()).unwrap(), geldig);
+        let rij = "\t".repeat(99) + "\n";
+        let t = CelTekst::lees(&rij.repeat(100)).unwrap();
+        assert_eq!((t.hoogte(), t.breedte()), (100, 100));
+        assert!(CelTekst::lees(&rij.repeat(101)).is_err());
+    }
+}
diff --git a/native/crates/office-core/src/rekenblad_klembord.rs b/native/crates/office-core/src/rekenblad_klembord.rs
new file mode 100644
index 0000000..5b171ea
--- /dev/null
+++ b/native/crates/office-core/src/rekenblad_klembord.rs
@@ -0,0 +1,166 @@
+//! Platte tabellen: opgemaakte waarden kopiëren en celinvoer gezamenlijk plakken.
+//! Geen rijke opmaakoverdracht, formuleverschuiving of verplaatsing van broncellen.
+use crate::{
+    celtekst::CelTekst,
+    document::{Fout, Resultaat},
+    rekenblad,
+};
+use betteroffice_xlsx as x;
+fn fout(e: impl std::fmt::Display) -> Fout {
+    Fout::Document(e.to_string())
+}
+fn blad(d: &x::Workbook, deel: usize) -> Resultaat<x::SheetId> {
+    if deel >= d.sheet_count() {
+        return Err(fout("Dit werkblad bestaat niet"));
+    }
+    Ok(x::SheetId(deel as u32))
+}
+pub fn doel(adres: &str, t: &CelTekst) -> Resultaat<x::CellRange> {
+    let r = rekenblad::bereik(adres)?;
+    let (hoog, breed) = (
+        (r.end.row - r.start.row + 1) as usize,
+        (r.end.col - r.start.col + 1) as usize,
+    );
+    if hoog == 1 && breed == 1 {
+        let einde = x::CellRef::new(
+            r.start
+                .row
+                .checked_add((t.hoogte() - 1) as u32)
+                .ok_or_else(|| fout("Het plakbereik valt buiten het werkblad"))?,
+            r.start
+                .col
+                .checked_add((t.breedte() - 1) as u32)
+                .ok_or_else(|| fout("Het plakbereik valt buiten het werkblad"))?,
+        );
+        return rekenblad::bereik(&format!("{}:{}", r.start.to_a1(), einde.to_a1()));
+    }
+    if !hoog.is_multiple_of(t.hoogte()) || !breed.is_multiple_of(t.breedte()) {
+        return Err(fout(
+            "De geselecteerde afmetingen passen niet bij het klembordbereik",
+        ));
+    }
+    Ok(r)
+}
+pub fn kopieer(d: &x::Workbook, deel: usize, adres: &str) -> Resultaat<String> {
+    let sheet = blad(d, deel)?;
+    let r = rekenblad::bereik(adres)?;
+    let gesloten = rekenblad::selectie(d, deel, &r.start.to_a1(), &r.end.to_a1())?;
+    let r = rekenblad::bereik(&gesloten.adres)?;
+    let merges = d.merged_ranges(sheet, r).map_err(fout)?;
+    let mut gedekt = std::collections::HashSet::new();
+    let mut werk = 0usize;
+    for m in merges {
+        for rij in m.start.row..=m.end.row {
+            for kolom in m.start.col..=m.end.col {
+                werk += 1;
+                if werk > crate::celtekst::MAX_CELLEN {
+                    return Err(fout(
+                        "Overlappende samenvoegingen passen niet in het klembordbereik",
+                    ));
+                }
+                if x::CellRef::new(rij, kolom) != m.start {
+                    gedekt.insert((rij, kolom));
+                }
+            }
+        }
+    }
+    let mut rijen = Vec::new();
+    let mut bytes = 0usize;
+    for rij in r.start.row..=r.end.row {
+        let mut cellen = Vec::new();
+        for kolom in r.start.col..=r.end.col {
+            let tekst = if gedekt.contains(&(rij, kolom)) {
+                String::new()
+            } else {
+                d.sheet(sheet)
+                    .map_err(fout)?
+                    .cell(x::CellRef::new(rij, kolom))
+                    .map(|cel| {
+                        xlsx_render::display_text(&d.model().styles, d.model().date_system, cel)
+                    })
+                    .unwrap_or_default()
+            };
+            bytes = bytes.saturating_add(tekst.len());
+            if bytes > crate::celtekst::MAX_BYTES {
+                return Err(fout(
+                    "De geselecteerde celinvoer is te groot voor het klembord",
+                ));
+            }
+            cellen.push(tekst);
+        }
+        rijen.push(cellen);
+    }
+    CelTekst::nieuw(rijen)
+        .map_err(fout)?
+        .schrijf()
+        .map_err(fout)
+}
+pub fn plak(d: &mut x::Workbook, deel: usize, adres: &str, t: &CelTekst) -> Resultaat<()> {
+    let sheet = blad(d, deel)?;
+    let mut r = doel(adres, t)?;
+    let enkel = t.hoogte() == 1 && t.breedte() == 1;
+    if enkel && r.start == r.end {
+        let anker = rekenblad::ankercel(d, deel, r.start)?;
+        r = d
+            .merged_ranges(sheet, x::CellRange::new(anker, anker))
+            .map_err(fout)?
+            .into_iter()
+            .next()
+            .unwrap_or(x::CellRange::new(anker, anker));
+        rekenblad::bereik(&format!("{}:{}", r.start.to_a1(), r.end.to_a1()))?;
+    }
+    let merges = d.merged_ranges(sheet, r).map_err(fout)?;
+    let wissen = enkel && t.rijen()[0][0].is_empty();
+    let gehele_merge = merges.len() == 1 && merges[0] == r;
+    for m in &merges {
+        let geheel = m.start.row >= r.start.row
+            && m.end.row <= r.end.row
+            && m.start.col >= r.start.col
+            && m.end.col <= r.end.col;
+        if !geheel || !(wissen || enkel && gehele_merge) {
+            return Err(fout(
+                "Plak eerst in gewone cellen; gedeeltelijke of meervoudige samenvoegingen worden niet overschreven",
+            ));
+        }
+    }
+    if d.sheet(sheet)
+        .map_err(fout)?
+        .array_formulas()
+        .any(|(_, a)| {
+            a.start.row <= r.end.row
+                && a.end.row >= r.start.row
+                && a.start.col <= r.end.col
+                && a.end.col >= r.start.col
+        })
+    {
+        return Err(fout(
+            "Een bestaande matrixformule wordt niet via het klembord gewijzigd",
+        ));
+    }
+    // Volledige controle vóór de ene gezamenlijke enginebewerking. Een late
+    // ongeldige formule mag geen eerdere cel uit hetzelfde plakblok bewaren.
+    let mut edits = Vec::new();
+    let mut bytes = 0usize;
+    for rij in r.start.row..=r.end.row {
+        for kolom in r.start.col..=r.end.col {
+            let cel = x::CellRef::new(rij, kolom);
+            if gehele_merge && !wissen && cel != r.start {
+                continue;
+            }
+            let tekst = &t.rijen()[(rij - r.start.row) as usize % t.hoogte()]
+                [(kolom - r.start.col) as usize % t.breedte()];
+            bytes = bytes.saturating_add(tekst.len());
+            if bytes > crate::celtekst::MAX_BYTES {
+                return Err(fout("De uitgezette celinvoer is te groot"));
+            }
+            rekenblad::controleer_invoer(d, deel, cel, tekst)?;
+            edits.push(x::CellInput {
+                cell: cel,
+                input: tekst.clone(),
+            });
+        }
+    }
+    d.edit_cells(sheet, &edits, x::CalculationOptions::default())
+        .map_err(fout)?;
+    Ok(())
+}
diff --git a/native/crates/office-core/tests/rekenblad_klembord.rs b/native/crates/office-core/tests/rekenblad_klembord.rs
