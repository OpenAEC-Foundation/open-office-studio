<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored regression controls for #375; independent of the genuine UOP fixture. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:styles>
  <draw:gradient draw:name="ControlGradient" draw:style="linear" draw:start-color="#112233" draw:end-color="#ddeeff" draw:start-intensity="100%" draw:end-intensity="100%" draw:angle="0" draw:border="0%"/>
  <style:style style:name="ThemeParent" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#bbe6fe" draw:stroke="solid" svg:stroke-color="#34b3fb" svg:stroke-width="0.03cm">
    <loext:fill-complex-color loext:theme-type="accent3" loext:color-type="theme">
     <loext:transformation loext:type="lummod" loext:value="4000"/>
     <loext:transformation loext:type="lumoff" loext:value="6000"/>
    </loext:fill-complex-color>
    <loext:stroke-complex-color loext:theme-type="accent4" loext:color-type="theme"/>
   </style:graphic-properties>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PageLayout"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/></style:page-layout>
  <style:style style:name="PlainRGB" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#14213d" draw:stroke="none"/></style:style>
  <style:style style:name="OverrideRGB" style:family="graphic" style:parent-style-name="ThemeParent"><style:graphic-properties draw:fill="solid" draw:fill-color="#046eff"/></style:style>
  <style:style style:name="InheritedTheme" style:family="graphic" style:parent-style-name="ThemeParent"><style:graphic-properties draw:auto-grow-height="false"/></style:style>
  <style:style style:name="ExplicitTheme" style:family="graphic" style:parent-style-name="ThemeParent">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#e0edf9">
    <loext:fill-complex-color loext:theme-type="accent2" loext:color-type="theme"><loext:transformation loext:type="lummod" loext:value="2000"/><loext:transformation loext:type="lumoff" loext:value="8000"/></loext:fill-complex-color>
   </style:graphic-properties>
  </style:style>
  <style:style style:name="NoFill" style:family="graphic" style:parent-style-name="ThemeParent"><style:graphic-properties draw:fill="none" draw:fill-color="#123456"/></style:style>
  <style:style style:name="GradientFill" style:family="graphic" style:parent-style-name="ThemeParent"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="ControlGradient" draw:fill-color="#123456"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Default" style:page-layout-name="PageLayout"/></office:master-styles>
 <office:body><office:presentation><draw:page draw:name="Controls" draw:master-page-name="Default">
  <draw:rect draw:name="plain-rgb" draw:style-name="PlainRGB" svg:x="1cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>plain RGB</text:p></draw:rect>
  <draw:rect draw:name="override-parent-theme" draw:style-name="OverrideRGB" svg:x="5cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>override RGB</text:p></draw:rect>
  <draw:rect draw:name="inherit-parent-theme" draw:style-name="InheritedTheme" svg:x="9cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>inherited theme</text:p></draw:rect>
  <draw:rect draw:name="explicit-theme" draw:style-name="ExplicitTheme" svg:x="13cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>explicit theme</text:p></draw:rect>
  <draw:rect draw:name="no-fill" draw:style-name="NoFill" svg:x="17cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>no fill</text:p></draw:rect>
  <draw:rect draw:name="gradient" draw:style-name="GradientFill" svg:x="21cm" svg:y="1cm" svg:width="3cm" svg:height="2cm"><text:p>gradient</text:p></draw:rect>
 </draw:page></office:presentation></office:body>
</office:document>
