+CPPUNIT_TEST_FIXTURE(XmloffDrawTest, testUOFExplicitRectangleFillColors)
+{
+    // Genuine UOF1 input: two distinct RGB fills must not inherit Accent1.
+    loadFromFile(u"uop-explicit-rectangle-fills.uop");
+    auto checkRectangles = [this]() {
+        uno::Reference<drawing::XDrawPagesSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(3), xSupplier->getDrawPages()->getCount());
+        uno::Reference<container::XIndexAccess> xPage(
+            xSupplier->getDrawPages()->getByIndex(2), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(4), xPage->getCount());
+        const sal_Int32 aExpected[] = { 0x14213d, 0x046eff };
+        for (sal_Int32 i = 0; i < 2; ++i)
+        {
+            uno::Reference<beans::XPropertySet> xShape(xPage->getByIndex(i + 1),
+                                                     uno::UNO_QUERY_THROW);
+            CPPUNIT_ASSERT_EQUAL(aExpected[i],
+                                 xShape->getPropertyValue(u"FillColor"_ustr).get<sal_Int32>());
+            uno::Reference<util::XComplexColor> xColor;
+            xShape->getPropertyValue(u"FillComplexColor"_ustr) >>= xColor;
+            CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Unknown,
+                                 model::color::getFromXComplexColor(xColor).getThemeColorType());
+        }
+    };
+    checkRectangles();
+    saveAndReload(TestFilter::PPTX_2007);
+    checkRectangles();
+    auto pXml = parseExport(u"ppt/slides/slide3.xml"_ustr);
+    assertXPath(pXml, "//p:sp[p:txBody//a:t='ODP']/p:spPr/a:solidFill/a:srgbClr", "val", u"14213D");
+    assertXPath(pXml, "//p:sp[p:txBody//a:t='UOP']/p:spPr/a:solidFill/a:srgbClr", "val", u"046EFF");
+    assertXPath(pXml, "//p:sp[p:txBody//a:t='ODP' or p:txBody//a:t='UOP']/p:spPr/a:solidFill/a:schemeClr", 0);
+}
