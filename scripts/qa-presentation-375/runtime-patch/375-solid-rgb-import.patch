+CPPUNIT_TEST_FIXTURE(XmloffDrawTest, testSolidRGBThemeInheritance)
+{
+    loadFromFile(u"solid-rgb-theme-inheritance.fodp");
+    auto checkColors = [this]() {
+        auto complexColor = [this](sal_uInt8 nShape, OUString const& rName) {
+            uno::Reference<beans::XPropertySet> xShape(getShape(nShape), uno::UNO_QUERY_THROW);
+            uno::Reference<util::XComplexColor> xColor;
+            xShape->getPropertyValue(rName) >>= xColor;
+            return model::color::getFromXComplexColor(xColor);
+        };
+        const sal_Int32 aRGB[] = { 0x14213d, 0x046eff };
+        for (sal_uInt8 i = 0; i < 2; ++i)
+        {
+            uno::Reference<beans::XPropertySet> xShape(getShape(i), uno::UNO_QUERY_THROW);
+            CPPUNIT_ASSERT_EQUAL(aRGB[i], xShape->getPropertyValue(u"FillColor"_ustr).get<sal_Int32>());
+            CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Unknown,
+                                 complexColor(i, u"FillComplexColor"_ustr).getThemeColorType());
+        }
+        // A parent theme without a local RGB override remains inherited.
+        auto aInherited = complexColor(2, u"FillComplexColor"_ustr);
+        CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Accent3, aInherited.getThemeColorType());
+        CPPUNIT_ASSERT_EQUAL(size_t(2), aInherited.getTransformations().size());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(4000), aInherited.getTransformations()[0].mnValue);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(6000), aInherited.getTransformations()[1].mnValue);
+        // An explicit theme plus its fallback RGB must not be cleared.
+        auto aExplicit = complexColor(3, u"FillComplexColor"_ustr);
+        CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Accent2, aExplicit.getThemeColorType());
+        CPPUNIT_ASSERT_EQUAL(size_t(2), aExplicit.getTransformations().size());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(2000), aExplicit.getTransformations()[0].mnValue);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(8000), aExplicit.getTransformations()[1].mnValue);
+        // No-fill/gradient RGB fallback values do not change complex-color inheritance.
+        for (sal_uInt8 i : { sal_uInt8(4), sal_uInt8(5) })
+            CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Accent3,
+                                 complexColor(i, u"FillComplexColor"_ustr).getThemeColorType());
+        uno::Reference<beans::XPropertySet> xNone(getShape(4), uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xGradient(getShape(5), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(drawing::FillStyle_NONE,
+                             xNone->getPropertyValue(u"FillStyle"_ustr).get<drawing::FillStyle>());
+        CPPUNIT_ASSERT_EQUAL(drawing::FillStyle_GRADIENT,
+                             xGradient->getPropertyValue(u"FillStyle"_ustr).get<drawing::FillStyle>());
+        // Clearing a fill must never alter the inherited stroke theme.
+        CPPUNIT_ASSERT_EQUAL(model::ThemeColorType::Accent4,
+                             complexColor(1, u"LineComplexColor"_ustr).getThemeColorType());
+    };
+    checkColors();
+    saveAndReload(TestFilter::ODP);
+    checkColors();
+}
 
