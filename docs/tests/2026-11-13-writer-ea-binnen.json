      "sectie": "    pub fn lower_story_json(&self, story: &str, env: &RenderEnv) -> Result<String, BridgeError> {\n        self.with_resident_story(story, env, |_| ())?;\n        let mut render = self.render.borrow_mut();\n        let lowered = render\n            .stories\n            .get_mut(story)\n            .expect(\"resident story exists after lowering\");\n        Ok(lowered\n            .serialized_blocks\n            .get_or_insert_with(|| {\n                serde_json::to_string(&lowered.blocks)\n                    .expect(\"LayoutBlock serialization is infallible after lowering\")\n            })\n            .clone())\n    }\n\n"
    },
    "wasm.rs": {
      "huidige_bron": ".local/integratiecontrole/font-hergebruik/bron/crates/docx-edit/src/wasm.rs",
