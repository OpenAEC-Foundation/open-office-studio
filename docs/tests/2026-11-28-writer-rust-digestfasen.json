      ".local/integratiecontrole/font-hergebruik/bron/packages/docx/src/yrs/yrsSessionFacade.ts": "4925b2c94be4ae21cedc3e47cf2d285f0d72a29dc5c0bc48bce183ad99dd5166",
      ".local/integratiecontrole/font-hergebruik/bron/crates/docx-edit/src/wasm.rs": "ae284682fdb9a3310dc22ec5e014a179e5fd99afea05a5bc5917844c3aa11d35",
      ".local/integratiecontrole/font-hergebruik/bron/crates/docx-edit/src/lib.rs": "df13aad72a2a8680711273d4eba6855afa41d4e612aaa78030e9fc152c454fe7"
