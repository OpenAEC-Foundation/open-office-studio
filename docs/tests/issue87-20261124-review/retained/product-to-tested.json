      "patch": "@@ -5,7 +5,36 @@ on:\n   workflow_dispatch:\n permissions:\n   contents: read\n+concurrency:\n+  group: presentation-87-date-open-${{ github.ref }}\n+  cancel-in-progress: true\n jobs:\n+  windows-web:\n+    runs-on: windows-latest\n+    timeout-minutes: 25\n+    steps:\n+      - uses: actions/checkout@v4\n+      - uses: actions/setup-node@v4\n+        with:\n+          node-version: 22\n+      - uses: pnpm/action-setup@v4\n+        with:\n+          version: 11.25.0\n+      - uses: dtolnay/rust-toolchain@stable\n+        with:\n+          targets: wasm32-unknown-unknown\n+      - run: pnpm install --frozen-lockfile\n+      - name: Focused date/footer/number and actual engine regressions\n+        run: pnpm exec vitest run src/presentatie/datumOpenen.test.ts src/presentatie/voetteksten.test.ts src/presentatie/dianummers.test.ts --configLoader runner --maxWorkers=2 --reporter=json --outputFile=.local/presentation-87-tests.json\n+      - name: Full frontend prebuild, TypeScript and production bundle\n+        run: pnpm build\n+      - uses: actions/upload-artifact@v4\n+        if: always()\n+        with:\n+          name: presentation-87-date-open-windows\n+          path: .local/presentation-87-tests.json\n+          include-hidden-files: true\n+          if-no-files-found: warn\n   linux-browser:\n     runs-on: ubuntu-22.04\n     timeout-minutes: 25"
    }
