{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", "packages/rekenbladen/src", "packages/database/src", "packages/vba/src", "packages/email/src", "packages/voorbeeld/src", "packages/voorbeeld/frame", "apps/database-studio/src"]
}
