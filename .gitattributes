# Deze upstreamteksten hebben een vastgelegde SHA-256 en moeten bytegelijk blijven.
docs/licenties/npm/*.txt text eol=lf
# Ook de bronpatch en de gecompileerde tekstkernen hebben vaste checksums.
# Lege contextregels in een diff bevatten een spatie.
patches/*.patch text eol=lf -whitespace
vendor/tekstengine/*.wasm binary
vendor/rekenbladengine/*.wasm binary
