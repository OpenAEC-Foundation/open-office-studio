{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Database Studio",
  "version": "2026.44.7",
  "identifier": "org.openaec.database-studio",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. database:dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm --dir ../.. database:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Database Studio",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "publisher": "OpenAEC Foundation",
    "copyright": "© 2026 OpenAEC Foundation",
    "shortDescription": "Open old MDB and ACCDB databases locally",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/open-database-studio.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/open-database-studio.desktop.hbs"
      }
    }
  }
}
