+/// Sort coordinates exactly as the wire keys do, without allocating a key
+/// string. The colon is significant: row 10 sorts before row 1 ("10:" < "1:").
+fn coordinate_order(mut value: u32, row: bool) -> [u8; 11] {
+    let mut reversed = [0_u8; 10];
+    let mut len = 0;
+    loop {
+        reversed[len] = b'0' + (value % 10) as u8;
+        len += 1;
+        value /= 10;
+        if value == 0 { break; }
+    }
+    let mut key = [0_u8; 11];
+    for index in 0..len { key[index] = reversed[len - index - 1]; }
+    if row { key[len] = b':'; }
+    key
+}
+
+/// Seeding needs lexical wire-key order, but not an extra workbook-sized map
+/// holding every key and encoded cell. Keep row IDs and one reusable row of
+/// references; encode each payload only as it enters the bootstrap document.
+struct SeedContents<'a> {
+    sheet: &'a Sheet,
+    rows: std::vec::IntoIter<u32>,
+    columns: Vec<[u8; 11]>,
+    cells: Vec<(CellRef, &'a Cell)>,
+    next: usize,
+}
+
+impl<'a> SeedContents<'a> {
+    fn new(sheet: &'a Sheet) -> Self {
+        let mut rows = Vec::new();
+        let mut max_col = 0;
+        for (at, cell) in sheet.iter_cells() {
+            if cell.formula.is_none() && matches!(&cell.value, CellValue::Empty) { continue; }
+            if rows.last() != Some(&at.row) { rows.push(at.row); }
+            max_col = max_col.max(at.col);
+        }
+        rows.sort_by_cached_key(|&row| coordinate_order(row, true));
+        let columns = if rows.is_empty() { Vec::new() } else {
+            (0..=max_col).map(|col| coordinate_order(col, false)).collect()
+        };
+        Self { sheet, rows: rows.into_iter(), columns, cells: Vec::new(), next: 0 }
+    }
+}
+
+impl Iterator for SeedContents<'_> {
+    type Item = (String, Any);
+    fn next(&mut self) -> Option<Self::Item> {
+        loop {
+            while let Some(&(at, cell)) = self.cells.get(self.next) {
+                self.next += 1;
+                if let Some(value) = content_to_any(cell) { return Some((cell_key(at), value)); }
+            }
+            let row = self.rows.next()?;
+            self.cells.clear();
+            self.cells.extend(self.sheet.iter_cells_in_rect(row..row + 1, 0..MAX_COLS));
+            let columns = &self.columns;
+            self.cells.sort_unstable_by_key(|(at, _)| columns.get(at.col as usize).copied().unwrap_or_else(|| coordinate_order(at.col, false)));
+            self.next = 0;
+        }
+    }
+}
