diff --git a/crates/xlsx-calc/tests/lange_ketens.rs b/crates/xlsx-calc/tests/lange_ketens.rs
new file mode 100644
--- /dev/null
+++ b/crates/xlsx-calc/tests/lange_ketens.rs
@@ -0,0 +1,128 @@
+use xlsx_calc::{
+    EvalContext, Value, evaluate, evaluate_array, parse_formula, rebuild_and_recalc_all,
+    recalc_after, references,
+};
+use xlsx_model::{Cell, CellRef, CellValue, ErrorValue, Sheet, SheetId, Workbook};
+
+fn getal(value: f64) -> CellValue {
+    CellValue::Number { value }
+}
+fn cel(adres: &str) -> CellRef {
+    CellRef::parse_a1(adres).unwrap()
+}
+fn werkmap() -> Workbook {
+    let mut wb = Workbook::default();
+    let mut sheet = Sheet::new("Blad 1");
+    sheet.set_cell(
+        cel("A1"),
+        Cell {
+            value: getal(10.0),
+            ..Cell::default()
+        },
+    );
+    sheet.set_cell(
+        cel("A2"),
+        Cell {
+            value: getal(20.0),
+            ..Cell::default()
+        },
+    );
+    wb.sheets.push(sheet);
+    wb
+}
+fn keten(term: &str, aantal: usize) -> String {
+    std::iter::repeat_n(term, aantal)
+        .collect::<Vec<_>>()
+        .join("+")
+}
+fn waarde(bron: &str, wb: &Workbook) -> CellValue {
+    evaluate(
+        &parse_formula(bron).unwrap(),
+        &EvalContext::new(wb, SheetId(0)),
+    )
+}
+
+#[test]
+fn rekent_lange_ketens_en_bewaart_de_formuletekst() {
+    let wb = werkmap();
+    for aantal in [101, 200, 400, 1000] {
+        let bron = keten("A1", aantal);
+        let expr = parse_formula(&bron).unwrap();
+        assert_eq!(
+            evaluate(&expr, &EvalContext::new(&wb, SheetId(0))),
+            getal(10.0 * aantal as f64)
+        );
+        assert_eq!(expr.to_formula(), bron);
+        assert_eq!(parse_formula(&expr.to_formula()).unwrap(), expr);
+        assert_eq!(references(&expr).len(), 1);
+    }
+}
+
+#[test]
+fn behoudt_volgorde_voorrang_en_afronding() {
+    let wb = werkmap();
+    let bron = format!("1000{}", "-1".repeat(399));
+    assert_eq!(waarde(&bron, &wb), getal(601.0));
+    let bron = format!("10000000000000000+1-10000000000000000{}", "+0".repeat(398));
+    assert_eq!(waarde(&bron, &wb), getal(0.0));
+    let lang = keten("A1", 400);
+    for (bron, verwacht) in [
+        (format!("{lang}*2"), 4010.0),
+        (format!("({lang})*2+3"), 8003.0),
+        (format!("(({lang})*2+3)/2"), 4001.5),
+        (format!("2/({lang})"), 0.0005),
+    ] {
+        let expr = parse_formula(&bron).unwrap();
+        assert_eq!(waarde(&bron, &wb), getal(verwacht));
+        assert_eq!(waarde(&expr.to_formula(), &wb), getal(verwacht));
+    }
+}
+
+#[test]
+fn behoudt_arrayberekening_en_foutvolgorde() {
+    let wb = werkmap();
+    let bron = keten("A1:A2", 400);
+    match evaluate_array(
+        &parse_formula(&bron).unwrap(),
+        &EvalContext::new(&wb, SheetId(0)),
+    ) {
+        Value::Array(a) => {
+            assert_eq!((a.rows(), a.cols()), (2, 1));
+            assert_eq!(a.at(0, 0), getal(4000.0));
+            assert_eq!(a.at(1, 0), getal(8000.0));
+        }
+        value => panic!("{value:?}"),
+    }
+    assert_eq!(waarde(&format!("SUMPRODUCT({bron})"), &wb), getal(12000.0));
+    let bron = format!("#DIV/0!{}+#N/A", "+0".repeat(400));
+    assert_eq!(
+        waarde(&bron, &wb),
+        CellValue::Error {
+            value: ErrorValue::Div0
+        }
+    );
+}
+
+#[test]
+fn herberekent_na_een_bronwijziging() {
+    let mut wb = werkmap();
+    let bron = format!("{}+A2", keten("A1", 400));
+    wb.sheets[0].set_cell(
+        cel("B1"),
+        Cell {
+            formula: Some(bron),
+            ..Cell::default()
+        },
+    );
+    let (mut graph, _) = rebuild_and_recalc_all(&mut wb, None);
+    assert_eq!(wb.sheets[0].cell(cel("B1")).unwrap().value, getal(4020.0));
+    wb.sheets[0].set_cell(
+        cel("A2"),
+        Cell {
+            value: getal(30.0),
+            ..Cell::default()
+        },
+    );
+    recalc_after(&mut wb, &mut graph, &[(SheetId(0), cel("A2"))], None);
+    assert_eq!(wb.sheets[0].cell(cel("B1")).unwrap().value, getal(4030.0));
+}
