+use betteroffice_xlsx::{
+    CalculationOptions, Cell, CellRange, CellRef, CellValue, EditRequest, Op, Sheet, SheetId,
+    Workbook, WorkbookModel,
+};
+use serde_json::json;
+
+fn cel(adres: &str) -> CellRef {
+    CellRef::parse_a1(adres).unwrap()
+}
+fn getal(value: f64) -> CellValue {
+    CellValue::Number { value }
+}
+fn werkmap() -> Workbook {
+    let mut bron = Sheet::new("Blad 1");
+    for (adres, waarde) in [("A1", 10.0), ("A2", 20.0)] {
+        bron.set_cell(
+            cel(adres),
+            Cell {
+                value: getal(waarde),
+                ..Cell::default()
+            },
+        );
+    }
+    Workbook::from_model(WorkbookModel {
+        sheets: vec![bron, Sheet::new("Som")],
+        ..Default::default()
+    })
+    .unwrap()
+}
+fn formule() -> String {
+    format!(
+        "{}+'Blad 1'!A2",
+        std::iter::repeat_n("'Blad 1'!A1", 400)
+            .collect::<Vec<_>>()
+            .join("+")
+    )
+}
+fn verwacht(wb: &Workbook, bron: &str, waarde: f64) {
+    let cell = wb.model().sheets[1].cell(cel("B1")).unwrap();
+    assert_eq!(cell.formula.as_deref(), Some(bron));
+    assert_eq!(cell.value, getal(waarde));
+    let invoer = wb.cell(SheetId(1), cel("B1")).unwrap();
+    assert!(invoer.is_formula);
+    assert_eq!(invoer.input, format!("={bron}"));
+}
+
+#[test]
+fn invoer_en_expliciete_formules_blijven_bewaard_en_herberekenen() {
+    for op in ["setCellInputs", "setFormulas"] {
+        let mut wb = werkmap();
+        let bron = formule();
+        let mut stap =
+            json!({"op":op,"target":{"sheetId":"sheet:1","range":{"kind":"a1","a1":"B1"}}});
+        if op == "setFormulas" {
+            stap["formulas"] = json!([[bron]]);
+        } else {
+            stap["inputs"] = json!([[format!("={bron}")]]);
+        }
+        let request: EditRequest =
+            serde_json::from_value(json!({"expectVersion":wb.version(),"steps":[stap]})).unwrap();
+        wb.apply_edits(&request).unwrap().unwrap();
+        verwacht(&wb, &bron, 4020.0);
+        let mut wb = Workbook::open(&wb.save().unwrap()).unwrap();
+        verwacht(&wb, &bron, 4020.0);
+        wb.edit_cell(SheetId(0), cel("A2"), "30", CalculationOptions::default())
+            .unwrap();
+        verwacht(&wb, &bron, 4030.0);
+        wb.undo(CalculationOptions::default()).unwrap();
+        verwacht(&wb, &bron, 4020.0);
+        wb.redo(CalculationOptions::default()).unwrap();
+        verwacht(&wb, &bron, 4030.0);
+    }
+}
