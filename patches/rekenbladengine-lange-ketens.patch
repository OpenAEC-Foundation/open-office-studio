+fn tree_depth(expr: &Expr) -> usize {
+    let mut pending = vec![(expr, 1)];
+    let mut depth = 0;
+    while let Some((expr, at)) = pending.pop() {
+        depth = depth.max(at);
+        match expr {
+            Expr::ArrayLiteral { values, .. } => pending.extend(values.iter().map(|e| (e, at + 1))),
+            Expr::Unary { expr, .. } | Expr::Percent(expr) => pending.push((expr, at + 1)),
+            Expr::Binary { lhs, rhs, .. }
+            | Expr::RangeJoin {
+                start: lhs,
+                end: rhs,
+            } => {
+                pending.push((lhs, at + 1));
+                pending.push((rhs, at + 1));
+            }
+            Expr::BinaryChain { first, rest } => {
+                pending.push((first, at + 1));
+                pending.extend(rest.iter().map(|(_, e)| (e, at + 1)));
+            }
+            Expr::FuncCall { args, .. } => pending.extend(args.iter().map(|e| (e, at + 1))),
+            _ => {}
+        }
+    }
+    depth
+}
