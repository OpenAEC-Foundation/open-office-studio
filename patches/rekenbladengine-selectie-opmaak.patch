+    /// A large uniform, borderless selection needs one resolved format, not
+    /// an owned font/fill/alignment/number-format clone for every cell. Check
+    /// effective styles, including row/column inheritance and empty cells.
+    /// Borders retain the positional aggregation used by the general route.
+    fn uniform_borderless_range_format(
+        &self,
+        sheet: SheetId,
+        range: CellRange,
+    ) -> Result<Option<CellFormat>> {
+        let sheet_ref = self.sheet(sheet)?;
+        let mut defaults = xlsx_model::workbook::ColumnDefaults::new(sheet_ref);
+        let first = defaults.effective_style(range.start).unwrap_or(0);
+        let format = self.model.styles.cell_format(Some(first));
+        if border_edges(&format.border).iter().any(Option::is_some) {
+            return Ok(None);
+        }
+        for row in range.start.row..=range.end.row {
+            for col in range.start.col..=range.end.col {
+                if defaults.effective_style(CellRef::new(row, col)).unwrap_or(0) != first {
+                    return Ok(None);
+                }
+            }
+        }
+        Ok(Some(format))
+    }
