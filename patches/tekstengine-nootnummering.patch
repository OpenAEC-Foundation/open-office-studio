+// De zichtbare tekst volgt de berekende nootnummering; documentposities
+// en semantische noot-id's blijven gelijk. Dit gebeurt vóór het meten.
+fn herstel_nootverwijzingen(
+    blocks: &mut [LayoutBlock],
+    labels: &docx_layout::footnotes::OrderedMap<i64, docx_layout::footnotes::NotePresentation>,
+) -> bool {
+    fn paragraph(
+        p: &mut docx_layout::types::ParagraphBlock,
+        labels: &docx_layout::footnotes::OrderedMap<i64, docx_layout::footnotes::NotePresentation>,
+    ) -> bool {
+        let mut changed = false;
+        for run in &mut p.runs {
+            let docx_layout::types::Run::Text(run) = run else { continue };
+            let key = run.fmt.footnote_ref_id.map(|id| id as i64).or_else(||
+                run.fmt.endnote_ref_id.map(|id| docx_layout::footnotes::note_reference_map_id(
+                    id as i64, docx_layout::footnotes::NoteKind::Endnote)));
+            if let Some(label) = key.and_then(|id| labels.get(&id))
+                && run.text != label.display_label {
+                run.text.clone_from(&label.display_label);
+                changed = true;
+            }
+        }
+        changed
+    }
+    let mut changed = false;
+    for block in blocks {
+        match block {
+            LayoutBlock::Paragraph(p) => changed |= paragraph(p, labels),
+            LayoutBlock::Table(t) => {
+                for row in &mut t.rows {
+                    for cell in &mut row.cells {
+                        changed |= herstel_nootverwijzingen(&mut cell.blocks, labels);
+                    }
+                }
+            }
+            LayoutBlock::TextBox(t) => {
+                for p in &mut t.content { changed |= paragraph(p, labels); }
+            }
+            _ => {}
+        }
+    }
+    changed
+}
