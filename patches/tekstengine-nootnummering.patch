+    fn splitsen_bewaart_oude_grenzen_en_voorkeursbreedtes_bij_derden() {
+        for (kind, preferred) in [
+            ("dxa", 4000.0),
+            ("dxa", 6000.0),
+            ("pct", 100.0),
+            ("pct", 80.0),
+        ] {
+            let doc = seed_table();
+            doc.merge_cells(&direct(), &TableRange::new(cell(0, 0), cell(0, 1)))
+                .unwrap();
+            doc.set_cell_text_format(
+                &direct(),
+                &TableRange::cell(cell(0, 0)),
+                &HashMap::from([
+                    ("widthType".to_owned(), Any::from(kind)),
+                    ("width".to_owned(), Any::Number(preferred)),
+                ]),
+            )
+            .unwrap();
+            let receipt = doc
+                .split_cell_grid(&direct(), &cell(0, 0), Some(1), Some(3))
+                .unwrap();
+            assert_eq!(receipt.columns, 4);
+            let (_, grid, rows) = table_value(&doc);
+            // 4000 / 3: 1334, 1333, 1333 twips. De oude grens op
+            // 2000 blijft bestaan: 0, 1334, 2000, 2667, 4000.
+            assert_eq!(grid, serde_json::json!([1334, 666, 667, 1333]));
+            assert_eq!(rows[0]["cells"].as_array().unwrap().len(), 3);
+            let upper = &rows[0]["cells"];
+            assert_eq!(upper[0]["tcPr"]["colspan"], 1);
+            assert_eq!(upper[1]["tcPr"]["colspan"], 2);
+            assert_eq!(upper[2]["tcPr"]["colspan"], 1);
+            assert_eq!(rows[1]["cells"][0]["tcPr"]["colspan"], 2);
+            assert_eq!(rows[1]["cells"][1]["tcPr"]["colspan"], 2);
+            assert_eq!(
+                grid[0].as_f64().unwrap() + grid[1].as_f64().unwrap(),
+                2000.0
+            );
+            for (i, twips) in [1334.0, 1333.0, 1333.0].into_iter().enumerate() {
+                let expected = preferred * twips / 4000.0;
+                assert!((upper[i]["tcPr"]["width"].as_f64().unwrap() - expected).abs() < 1e-9);
+            }
+            yrs_doc_to_layout_blocks(&doc, "body", &RenderEnv::default()).unwrap();
+        }
+    }
