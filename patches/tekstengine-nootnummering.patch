+    fn nootlabel_blijft_een_atoom_met_volledige_glyphbreedte() {
+        let fixture = fixture();
+        for eindnoot in [false, true] {
+            let mut run = text_run("iii");
+            let Run::Text(ref mut text) = run else {
+                unreachable!()
+            };
+            text.fmt.superscript = Some(true);
+            text.fmt.letter_spacing = Some(0.5);
+            let gewoon = paragraph(vec![run.clone()], None);
+            let breedte = measure_paragraph(&gewoon, 100.0, &fixture.config, None, 0.0)
+                .unwrap()
+                .lines[0]
+                .width;
+            let Run::Text(ref mut text) = run else {
+                unreachable!()
+            };
+            if eindnoot {
+                text.fmt.endnote_ref_id = Some(1.0);
+            } else {
+                text.fmt.footnote_ref_id = Some(1.0);
+            }
+            let blok = paragraph(vec![run], None);
+            for beschikbaar in [100.0, 1.0] {
+                assert_parity("nootatoom", &blok, beschikbaar, &fixture.config, None, 0.0);
+                let gemeten =
+                    measure_paragraph(&blok, beschikbaar, &fixture.config, None, 0.0).unwrap();
+                assert_eq!(gemeten.lines.len(), 1);
+                assert!((gemeten.lines[0].width - breedte).abs() < 0.001);
+                assert_eq!(gemeten.lines[0].tail_char, 1);
+                let clusters = gemeten.lines[0].cluster_advances.as_ref().unwrap();
+                assert_eq!(clusters.len(), 1);
+                assert_eq!(clusters[0].start_char, Some(0));
+                assert_eq!(clusters[0].end_char, Some(1));
+            }
+        }
+    }
