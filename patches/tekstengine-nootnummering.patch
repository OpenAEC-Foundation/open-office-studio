+use super::*;
+
+#[test]
+fn math_preview_requires_current_source_and_valid_metrics() {
+    let mut values = HashMap::from([
+        ("ommlXml".to_owned(), Any::String("<m:oMath/>".into())),
+        ("renderSource".to_owned(), Any::String("<m:oMath/>".into())),
+        ("renderSvg".to_owned(), Any::String("data:image/svg+xml;base64,PHN2Zy8+".into())),
+        ("renderWidth".to_owned(), Any::Number(80.0)),
+        ("renderHeight".to_owned(), Any::Number(40.0)),
+        ("renderDepth".to_owned(), Any::Number(12.0)),
+    ]);
+    let image = lower_math_values(&values, &RenderEnv::default()).unwrap();
+    assert_eq!(image.width, 80.0);
+    assert_eq!(image.height, 40.0);
+    assert_eq!(image.dist_bottom, Some(12.0));
+    assert_eq!(image.display_mode.as_deref(), Some("math"));
+    values.insert("renderSource".to_owned(), Any::String("old".into()));
+    assert!(lower_math_values(&values, &RenderEnv::default()).is_none());
+    values.insert("renderSource".to_owned(), Any::String("<m:oMath/>".into()));
+    values.insert("renderDepth".to_owned(), Any::Number(41.0));
+    assert!(lower_math_values(&values, &RenderEnv::default()).is_none());
+}
