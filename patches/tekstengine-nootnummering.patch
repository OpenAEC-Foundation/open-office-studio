+fn lower_math_values(values: &HashMap<String, Any>, env: &RenderEnv) -> Option<ImageRun> {
+    let src = map_string(values, "renderSvg")?;
+    let source = map_string(values, "renderSource")?;
+    if source != map_string(values, "ommlXml")? || !src.starts_with("data:image/svg+xml;base64,") || src.len() > 2_000_000 {
+        return None;
+    }
+    let width = map_number(values, "renderWidth")?;
+    let height = map_number(values, "renderHeight")?;
+    let depth = map_number(values, "renderDepth")?;
+    if ![width, height, depth].iter().all(|n| n.is_finite()) || width <= 0.0 || height <= 0.0 || width > 20000.0 || height > 20000.0 || depth < 0.0 || depth > height {
+        return None;
+    }
+    let image = HashMap::from([
+        ("src".to_owned(), Any::String(src.into())),
+        ("width".to_owned(), Any::Number(width)),
+        ("height".to_owned(), Any::Number(height)),
+        ("distBottom".to_owned(), Any::Number(depth)),
+        ("displayMode".to_owned(), Any::String("math".into())),
+        ("alt".to_owned(), Any::String("Equation".into())),
+    ]);
+    let mut rendered = lower_image_values(&image, &RunFormatting::default(), env);
+    rendered.dist_bottom = Some(depth * rendered.height / height);
+    Some(rendered)
+}
