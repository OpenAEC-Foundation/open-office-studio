+#[test]
+fn opslag_ververst_gedeelde_formules_en_waardetypen_met_behoud_van_onbekende_delen() {
+    let mut parts = preservation_fixture_parts();
+    set_test_part(&mut parts, "xl/worksheets/sheet1.xml", br#"<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData><row r="1"><c r="A1"><v>1</v></c><c r="B1"><f t="shared" si="0" ref="B1:B2">A1*2</f><v>99</v></c><c r="C1" t="str"><f>IF(TRUE(),&quot;nieuw&quot;,&quot;oud&quot;)</f><v>oud</v></c><c r="D1" t="b"><f>1=1</f><v>0</v></c><c r="E1" t="e"><f>1/0</f><v>#VALUE!</v></c><c r="F1"><f>ONBEKEND()</f><v>81</v></c></row><row r="2"><c r="A2"><v>2</v></c><c r="B2"><f t="shared" si="0"/><v>99</v></c><c r="F2"><f>F1+1</f><v>82</v></c></row></sheetData></worksheet>"#.to_vec());
+    let source = ooxml_opc::rezip_parts(&parts).unwrap();
+    let workbook = Workbook::open_recalculated(&source, CalculationOptions::default()).unwrap();
+    let saved = workbook.save().unwrap();
+    let measured = Workbook::open(&saved).unwrap();
+    // B1=1×2=2, B2=2×2=4. De onbekende functie en haar afhankelijke cache blijven behouden.
+    for (address, value) in [
+        ("B1", CellValue::Number { value: 2.0 }),
+        ("B2", CellValue::Number { value: 4.0 }),
+        (
+            "C1",
+            CellValue::Text {
+                value: "nieuw".into(),
+            },
+        ),
+        ("D1", CellValue::Bool { value: true }),
+        (
+            "E1",
+            CellValue::Error {
+                value: ErrorValue::Div0,
+            },
+        ),
+        ("F1", CellValue::Number { value: 81.0 }),
+        ("F2", CellValue::Number { value: 82.0 }),
+    ] {
+        assert_eq!(
+            measured.model().value(SheetId(0), cell(address)),
+            value,
+            "{address}"
+        );
+    }
+    let source_parts = package_map(&source);
+    let saved_parts = package_map(&saved);
+    assert!(!saved_parts.contains_key("xl/calcChain.xml"));
+    for (name, bytes) in source_parts {
+        if [
+            "xl/worksheets/sheet1.xml",
+            "xl/workbook.xml",
+            "xl/_rels/workbook.xml.rels",
+            "[Content_Types].xml",
+            "xl/calcChain.xml",
+        ]
+        .contains(&name.as_str())
+        {
+            continue;
+        }
+        assert_eq!(saved_parts.get(&name), Some(&bytes), "{name}");
+    }
+    let sheet = String::from_utf8(saved_parts["xl/worksheets/sheet1.xml"].clone()).unwrap();
+    assert!(sheet.contains("si=\"0\""));
+    assert!(sheet.contains("ref=\"B1:B2\""));
+}
