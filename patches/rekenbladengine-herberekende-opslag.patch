+#[test]
+fn opslag_behoudt_het_containerarchief_bij_gelijke_uitkomsten() {
+    for (formula, cache) in [("1+2", "<v>3</v>"), ("ONBEKEND()", "<v>81</v>")] {
+        let source = recalculation_fixture(formula, cache);
+        assert_eq!(Workbook::open(&source).unwrap().save().unwrap(), source);
+        for workbook in [
+            Workbook::open_recalculated(&source, CalculationOptions::default()).unwrap(),
+            Workbook::open_collaborative_recalculated(&source, 703, CalculationOptions::default())
+                .unwrap(),
+        ] {
+            assert_eq!(workbook.save().unwrap(), source, "{formula}");
+        }
+    }
+}
