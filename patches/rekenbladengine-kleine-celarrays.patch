+        fn check<const N: usize>(values: [Any; N]) {
+            let legacy = Any::Array(Arc::from(Vec::from(values.clone())));
+            let actual = any_array(values);
+            let mut expected_bytes = Vec::new();
+            let mut actual_bytes = Vec::new();
