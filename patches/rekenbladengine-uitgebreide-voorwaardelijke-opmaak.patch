+#[test]
+fn replace_rules_preserves_stop_priority_styles_and_undo_in_one_transaction() {
+    let mut wb = Workbook::open(&bytes(Some(r#"<cellXfs count="1"><xf/></cellXfs>"#))).unwrap();
+    wb.apply_ops(vec![add("expression", None, &["A1>5"])], CalculationOptions::default()).unwrap();
+    let before = wb.model().sheets[0].conditional_formats.clone();
+    let mut formats = before.clone();
+    let rule = &mut formats[0].rules[0];
+    rule.priority = 2;
+    rule.raw_xml = Some(r#"<cfRule xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" type="expression" priority="2" stopIfTrue="1"><formula>A1&gt;5</formula></cfRule>"#.into());
+    wb.apply_ops(vec![Op::SetConditionalFormats { sheet: SheetId(0), formats: formats.clone() }], CalculationOptions::default()).unwrap();
+    assert_eq!(wb.model().sheets[0].conditional_formats, formats);
+    let reopened = Workbook::open(&wb.save().unwrap()).unwrap();
+    let rule = &reopened.model().sheets[0].conditional_formats[0].rules[0];
+    assert_eq!(rule.priority, 2);
+    assert!(rule.format.font_color.as_deref().is_some_and(|c| c.eq_ignore_ascii_case("#FF0000")));
+    assert!(rule.raw_xml.as_ref().unwrap().contains(r#"stopIfTrue="1""#));
+    wb.undo(CalculationOptions::default()).unwrap();
+    assert_eq!(wb.model().sheets[0].conditional_formats, before);
+    wb.redo(CalculationOptions::default()).unwrap();
+    assert_eq!(wb.model().sheets[0].conditional_formats, formats);
+}
