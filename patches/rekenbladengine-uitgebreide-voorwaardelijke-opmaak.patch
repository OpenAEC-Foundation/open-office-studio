+#[test]
+fn invalid_replacements_refuse_before_any_mutation() {
+    let mut wb = Workbook::open(&bytes(Some(r#"<cellXfs count="1"><xf/></cellXfs>"#))).unwrap();
+    wb.apply_ops(vec![add("expression", None, &["A1>5"])], CalculationOptions::default()).unwrap();
+    let before = wb.model().sheets[0].conditional_formats.clone();
+    for raw in ["<worksheet/>", "<cfRule>", "<cfRule/><cfRule/>", "<!DOCTYPE a><cfRule/>", "text<cfRule/>"] {
+        let mut formats = before.clone(); formats[0].rules[0].raw_xml = Some(raw.into());
+        assert!(wb.apply_ops(vec![Op::SetConditionalFormats { sheet: SheetId(0), formats }], CalculationOptions::default()).is_err(), "{raw}");
+        assert_eq!(wb.model().sheets[0].conditional_formats, before);
+    }
+    for a1 in ["", "A0", "XFE1", "A1048577"] {
+        let mut formats = before.clone(); formats[0].sqref = a1.into();
+        assert!(wb.apply_ops(vec![Op::SetConditionalFormats { sheet: SheetId(0), formats }], CalculationOptions::default()).is_err(), "{a1}");
+        assert_eq!(wb.model().sheets[0].conditional_formats, before);
+    }
+}
