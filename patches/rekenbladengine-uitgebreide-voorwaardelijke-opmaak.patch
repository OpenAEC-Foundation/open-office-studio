+#[test]
+fn changing_existing_application_range_updates_source_wrapper_and_keeps_extensions() {
+    let source = parts(r#"<sheetData/><conditionalFormatting xmlns:v="urn:test" sqref="A1:A3" v:flag="keep"><cfRule type="expression" priority="1"><formula>A1&gt;5</formula></cfRule><extLst><ext uri="keep"><v:data/></ext></extLst></conditionalFormatting>"#, None);
+    let parsed = parse_workbook_with_package(&source).unwrap();
+    let mut workbook = parsed.workbook.clone();
+    workbook.sheets[0].conditional_formats[0].sqref = "B1:B3 D1:D3".to_owned();
+    let saved = save(&parsed, &workbook);
+    let xml = std::str::from_utf8(part(&saved, "xl/worksheets/sheet1.xml")).unwrap();
+    assert!(xml.contains(r#"sqref="B1:B3 D1:D3""#), "{xml}");
+    assert!(xml.contains(r#"v:flag="keep""#), "{xml}");
+    assert!(xml.contains("<v:data/>"), "{xml}");
+    let reopened = parse_workbook(&saved).unwrap();
+    assert_eq!(reopened.sheets[0].conditional_formats[0].sqref, "B1:B3 D1:D3");
+}
