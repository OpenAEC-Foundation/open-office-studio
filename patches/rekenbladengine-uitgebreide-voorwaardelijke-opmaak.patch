+/// Validate a complete conditional-format replacement before committing it.
+/// Unknown source rule kinds retain their raw XML; every root must still be a
+/// bounded, well-formed cfRule with an in-bounds application range and style.
+pub fn validate_conditional_formats(
+    formats: &[xlsx_model::ConditionalFormatting],
+    differential_styles: usize,
+) -> Result<(), ParseError> {
+    let invalid = |message: &str| ParseError::Malformed(message.into());
+    let mut ids = HashSet::new();
+    let mut bytes = 0usize;
+    for group in formats {
+        if group.sqref.split_whitespace().next().is_none() {
+            return Err(invalid("empty conditional format range"));
+        }
+        for a1 in group.sqref.split_whitespace() {
+            let range = CellRange::parse_a1(a1).map_err(|_| invalid("invalid conditional format range"))?;
+            if range.end.row >= xlsx_model::addr::MAX_ROWS || range.end.col >= xlsx_model::addr::MAX_COLS {
+                return Err(invalid("conditional format range outside grid"));
+            }
+        }
+        for rule in &group.rules {
+            if rule.id.is_empty() || !ids.insert(&rule.id) || ids.len() > 65536 || rule.priority == 0 {
+                return Err(invalid("invalid conditional format identity or priority"));
+            }
+            if rule.dxf_id.is_some_and(|id| id as usize >= differential_styles) {
+                return Err(invalid("conditional format differential style outside table"));
+            }
+            for color in [&rule.format.font_color, &rule.format.fill].into_iter().flatten() {
+                if !color.strip_prefix('#').is_some_and(|hex| hex.len() == 6 && hex.bytes().all(|c| c.is_ascii_hexdigit())) {
+                    return Err(invalid("invalid conditional format color"));
+                }
+            }
+            if let Some(raw) = &rule.raw_xml {
+                bytes = bytes.saturating_add(raw.len());
+                if bytes > 16 * 1024 * 1024 { return Err(invalid("conditional format XML too large")); }
+                let mut reader = Reader::from_str(raw);
+                let mut depth = 0usize;
+                let mut roots = 0usize;
+                let mut root = |e: &BytesStart<'_>, depth: usize| -> Result<(), ParseError> {
+                    if depth == 0 {
+                        roots += 1;
+                        if roots != 1 || e.name().local_name().as_ref() != b"cfRule" {
+                            return Err(invalid("conditional format XML must contain one cfRule"));
+                        }
+                    }
+                    Ok(())
+                };
+                loop {
+                    match reader.read_event().map_err(xml_err)? {
+                        Event::Start(e) => {
+                            root(&e, depth)?;
+                            depth += 1;
+                            if depth > 256 { return Err(invalid("conditional format XML too deep")); }
+                        }
+                        Event::Empty(e) => root(&e, depth)?,
+                        Event::End(_) => { depth = depth.checked_sub(1).ok_or_else(|| invalid("unbalanced conditional format XML"))?; }
+                        Event::DocType(_) | Event::Decl(_) => return Err(invalid("conditional format XML cannot contain a document declaration")),
+                        Event::Text(e) if depth == 0 && e.as_ref().iter().any(|c| !c.is_ascii_whitespace()) => return Err(invalid("text outside conditional format XML")),
+                        Event::Eof => break,
+                        _ => {}
+                    }
+                }
+                drop(root);
+                if roots != 1 || depth != 0 { return Err(invalid("incomplete conditional format XML")); }
+            } else if !matches!(rule.rule_type.as_str(), "cellIs" | "expression") {
+                return Err(invalid("extended conditional format requires its XML"));
+            }
+        }
+    }
+    Ok(())
+}
