+#[test]
+fn authored_extended_rule_keeps_stop_flag_and_gets_a_valid_differential_style() {
+    let source = parts("<sheetData/>", Some(r#"<fonts count="1"><font/></fonts><cellXfs count="1"><xf/></cellXfs>"#));
+    let parsed = parse_workbook_with_package(&source).unwrap();
+    let mut wb = parsed.workbook.clone();
+    authored(&mut wb);
+    let rule = &mut wb.sheets[0].conditional_formats[0].rules[0];
+    rule.raw_xml = Some(r#"<cfRule xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" type="cellIs" operator="greaterThan" priority="9" stopIfTrue="1"><formula>5</formula></cfRule>"#.into());
+    let saved = save(&parsed, &wb);
+    let sheet = String::from_utf8(part(&saved, "xl/worksheets/sheet1.xml").to_vec()).unwrap();
+    assert!(sheet.contains(r#"stopIfTrue="1""#), "{sheet}");
+    assert!(sheet.contains(r#"dxfId="0""#), "{sheet}");
+    let reopened = parse_workbook(&saved).unwrap();
+    let rule = &reopened.sheets[0].conditional_formats[0].rules[0];
+    assert_eq!(rule.format.font_color.as_deref(), Some("#FF0000"));
+    assert_eq!(rule.format.fill.as_deref(), Some("#00FF00"));
+    assert_eq!(rule.format.bold, Some(true));
+    assert!(rule.raw_xml.as_ref().unwrap().contains(r#"stopIfTrue="1""#));
+}
