+    /// Read-only evaluation for conditional formats. Existing cells, cached values,
+    /// history, calculation state and document version are never changed.
+    fn read_formula_queries(&self, request: &str) -> Result<String> {
+        let request: FormulaQueryRequest = decode(request)?;
+        if !request.ranges.is_empty() || request.formula_queries.len() > 4096
+            || request.formula_queries.iter().map(|q| q.formula.len()).sum::<usize>() > 1_048_576
+        {
+            return Ok(self.limit_refusal("formula queries exceed the bounded read limit".to_owned()));
+        }
+        if request.now_serial.is_some_and(|n| !n.is_finite()) {
+            return Err(Error::InvalidRequest("nowSerial must be finite".to_owned()));
+        }
+        let keys = self.sheet_keys();
+        let mut queries = Vec::with_capacity(request.formula_queries.len());
+        for query in &request.formula_queries {
+            let Some(index) = keys.iter().position(|key| key == &query.sheet_id) else {
+                return Err(Error::InvalidRequest("formula query refers to an unknown sheet".to_owned()));
+            };
+            if query.formula.len() > 8192 || [query.origin, query.target].iter().any(|p| p.row >= 1_048_576 || p.col >= 16_384) {
+                return Err(Error::InvalidRequest("formula query exceeds the formula or cell bounds".to_owned()));
+            }
+            queries.push((SheetId(index as u32), query));
+        }
+        let mut context = xlsx_calc::EvalContext::new(&self.model, SheetId(0));
+        context.date_system = self.model.date_system;
+        context.now_serial = request.now_serial.map(|n| n - if self.model.date_system == xlsx_model::DateSystem::V1904 { 1462.0 } else { 0.0 });
+        context.rand_seed = self.rand_seed.map(u64::from);
+        let mut values = Vec::with_capacity(queries.len());
+        let mut limited = Vec::new();
+        for (index, (sheet, query)) in queries.iter().enumerate() {
+            let formula = xlsx_parse::translate_formula(
+                query.formula.strip_prefix('=').unwrap_or(&query.formula),
+                CellRef::new(query.origin.row, query.origin.col),
+                CellRef::new(query.target.row, query.target.col),
+            );
+            let at = context.at_cell(*sheet, CellRef::new(query.target.row, query.target.col));
+            let value = formula.ok().and_then(|f| parse_formula(&f).ok())
+                .map(|expression| xlsx_calc::evaluate(&expression, &at))
+                .unwrap_or(CellValue::Error { value: xlsx_model::ErrorValue::Value });
+            if at.exhausted() { limited.push(index); }
+            values.push(value);
+        }
+        let read = self.read_cells(&ReadRequest::default())?;
+        match read {
+            Ok(read) => {
+                let mut body = serde_json::to_value(read).map_err(|e| Error::InvalidOperation(e.to_string()))?;
+                body["formulaResults"] = serde_json::to_value(values).map_err(|e| Error::InvalidOperation(e.to_string()))?;
+                body["formulaLimited"] = serde_json::json!(limited);
+                self.bounded_json(&Ok(body))
+            },
+            Err(refused) => self.bounded_json::<Value>(&Err(refused)),
+        }
+    }
