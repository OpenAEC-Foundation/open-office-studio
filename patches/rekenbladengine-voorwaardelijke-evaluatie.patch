diff --git a/crates/betteroffice-xlsx/tests/conditional_formula_queries.rs b/crates/betteroffice-xlsx/tests/conditional_formula_queries.rs
new file mode 100644
index 0000000..ff7d767
--- /dev/null
+++ b/crates/betteroffice-xlsx/tests/conditional_formula_queries.rs
@@ -0,0 +1,55 @@
+use betteroffice_xlsx::{Workbook, Sheet, SheetId, CellRef, CellValue};
+use serde_json::Value;
+use serde_json::json;
+
+fn query(sheet: &str, origin: (u32, u32), target: (u32, u32), formula: &str) -> Value {
+    json!({"sheetId":sheet,"origin":{"row":origin.0,"col":origin.1},"target":{"row":target.0,"col":target.1},"formula":formula})
+}
+
+#[test]
+fn conditional_formula_queries_use_actual_context_without_editing() {
+    let mut model = xlsx_model::Workbook::default();
+    model.sheets = vec![Sheet::new("Source"), Sheet::new("Other")];
+    model.sheets[0].set_cell(CellRef::new(0, 0), xlsx_model::Cell { value: CellValue::Number { value: 3.0 }, ..Default::default() });
+    model.sheets[0].set_cell(CellRef::new(1, 0), xlsx_model::Cell { value: CellValue::Number { value: 9.0 }, ..Default::default() });
+    model.defined_names.push(xlsx_model::DefinedName { name: "Limit".to_owned(), formula: "Source!$A$1".to_owned(), local_sheet: Some(SheetId(0)), hidden: false });
+    model.defined_names.push(xlsx_model::DefinedName { name: "MyRow".to_owned(), formula: "ROW()".to_owned(), local_sheet: Some(SheetId(0)), hidden: false });
+    let book = Workbook::from_model(model).unwrap();
+    let version = book.version();
+    let saved = book.save().unwrap();
+    let request = json!({"ranges":[],"formulaQueries":[
+        query("sheet:0", (0,0),(1,0),"AND(ROW()=2,COLUMN()=1,A1=9,$A$1=3,SUM(A:A)=12,Limit=3,MyRow=2)"),
+        query("sheet:0", (0,0),(0,0),"AND(ROW()=1,COLUMN()=1,SUM(1:1)=3,MyRow=1)"),
+        query("sheet:1", (0,0),(4,3),"AND(ROW()=5,COLUMN()=4,Source!$A$1=3)"),
+        query("sheet:0", (0,0),(0,0),"1/0")
+    ]});
+    let result: Value = serde_json::from_str(&book.read_cells_json(&request.to_string()).unwrap()).unwrap();
+    assert_eq!(result["ok"], true);
+    assert_eq!(result["formulaResults"], json!([
+        {"kind":"bool","value":true},{"kind":"bool","value":true},{"kind":"bool","value":true},{"kind":"error","value":"#DIV/0!"}
+    ]));
+    assert_eq!(result["formulaLimited"], json!([]));
+    assert_eq!(book.version(), version);
+    assert_eq!(book.save().unwrap(), saved);
+    assert!(!book.can_undo());
+}
+
+#[test]
+fn conditional_formula_queries_convert_clock_and_refuse_malformed_requests() {
+    let mut model = xlsx_model::Workbook::default();
+    model.date_system = xlsx_model::DateSystem::V1904;
+    model.sheets.push(Sheet::new("Sheet1"));
+    let book = Workbook::from_model(model).unwrap();
+    let request = json!({"ranges":[],"nowSerial":46000.5,"formulaQueries":[query("sheet:0",(0,0),(0,0),"NOW()=44538.5")]});
+    let result: Value = serde_json::from_str(&book.read_cells_json(&request.to_string()).unwrap()).unwrap();
+    assert_eq!(result["formulaResults"][0], json!({"kind":"bool","value":true}));
+    let bad = json!({"ranges":[],"formulaQueries":[query("sheet:0",(0,0),(1048576,0),"TRUE")]});
+    assert!(book.read_cells_json(&bad.to_string()).is_err());
+    let bad = json!({"ranges":[],"formulaQueries":[query("missing",(0,0),(0,0),"TRUE")]});
+    assert!(book.read_cells_json(&bad.to_string()).is_err());
+    let bad = json!({"ranges":[],"formulaQueries":vec![query("sheet:0",(0,0),(0,0),"TRUE");4097]});
+    let result: Value = serde_json::from_str(&book.read_cells_json(&bad.to_string()).unwrap()).unwrap();
+    assert_eq!(result["ok"], false);
+    assert!(!book.can_undo());
+}
+
