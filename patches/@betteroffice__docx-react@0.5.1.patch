diff --git a/dist/openaec-renderer.mjs b/dist/openaec-renderer.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4bfd4a92ac58eb8ec54de83f9219ded2cbc75af9
--- /dev/null
+++ b/dist/openaec-renderer.mjs
@@ -0,0 +1,28 @@
+import { onDisplayListQuerySourceFailure } from "@betteroffice/docx/layout/render";
+
+/** Een laadbelofte zegt niets over de huidige bruikbaarheid van de Wasm-bron. */
+export function volgOpenAecQueryBron(queries, meld) {
+  let actief = true, vorigeReady, vorigeFout, laadFout = null;
+  const ververs = () => {
+    if (!actief) return;
+    const bron = queries?.sourceState();
+    const error = bron?.status === "error" ? bron.error : laadFout;
+    const ready = !error && queries?.isReady() === true;
+    if (ready === vorigeReady && error === vorigeFout) return;
+    vorigeReady = ready;
+    vorigeFout = error;
+    meld({ ready, error });
+  };
+  // Eerst aanmelden, daarna lezen: ook een fout vóór deze effectfase blijft
+  // via sourceState zichtbaar. Een andere instantie verandert deze bron niet.
+  const stop = queries ? onDisplayListQuerySourceFailure(ververs) : () => {};
+  ververs();
+  if (queries?.sourceState().status === "loading") {
+    queries.whenReady().then(ververs, fout => {
+      if (!actief) return;
+      laadFout = fout instanceof Error ? fout : new Error(String(fout));
+      ververs();
+    });
+  }
+  return () => { actief = false; stop(); };
+}
