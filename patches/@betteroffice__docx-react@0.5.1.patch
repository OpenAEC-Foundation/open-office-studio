+export async function handelOpenAecPlakAf(handler, session, range, fragment, author, current, notify, clipboardEvent) {
+  session.addUndoBoundary();
+  try {
+    const toegepast = await handler(session, range, fragment, author, current, clipboardEvent);
+    if (toegepast && current()) notify();
+  } finally {
+    if (current()) session.addUndoBoundary();
+  }
+}
