--- /dev/null
+++ b/dist/openaec-selectie.mjs
@@ -0,0 +1,12 @@
+// Een leesvraag mag een geldige broncursor nooit naar het documentbegin verplaatsen.
+// Direct na een structuurwijziging kan de weergavekaart nog oudere alinea's bevatten.
+export function leesGeldigeOpenAecSelectie(session, toegestaan, kaart) {
+  if (!session) return null;
+  const selectie = session.selection();
+  if (!selectie || selectie.anchor.story !== selectie.head.story || !toegestaan(selectie.anchor.story)
+    || !session.hasStory(selectie.anchor.story)) return null;
+  const bevat = alineas => alineas?.some(p => p.paraId === selectie.anchor.paraId)
+    && alineas.some(p => p.paraId === selectie.head.paraId);
+  if (bevat(kaart(selectie.anchor.story)?.paragraphs)) return selectie;
+  return bevat(session.paragraphSpans(selectie.anchor.story)) ? selectie : null;
+}
