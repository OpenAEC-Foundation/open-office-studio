+++ b/dist/openaec-lijst.mjs
@@ -0,0 +1,76 @@
+// Lijstnummers zijn verwijzingen binnen één document, geen lijstsoorten.
+export function listKind(properties) {
+  if (!(properties?.numPr?.numId > 0)) return null;
+  if (properties.listIsBullet === true || properties.listNumFmt === "bullet") return "bullet";
+  if (properties.listIsBullet === false || properties.listNumFmt && properties.listNumFmt !== "none") return "numbered";
+  return null;
+}
+
+function levelFor(definitions, numId, ilvl) {
+  const instance = definitions?.nums?.find(n => n.numId === numId);
+  if (!instance) return null;
+  const abstract = definitions.abstractNums?.find(n => n.abstractNumId === instance.abstractNumId);
+  const override = instance.levelOverrides?.find(n => n.ilvl === ilvl);
+  const level = override?.lvl ?? abstract?.levels?.find(n => n.ilvl === ilvl);
+  return level ? { instance, abstract, level, start: override?.startOverride } : null;
+}
+
+const emptyHints = {
+  listIsBullet: null, listNumFmt: null, listMarker: null,
+  listMarkerHidden: null, listMarkerFontFamily: null, listMarkerFontSize: null,
+  listMarkerBold: null, listMarkerItalic: null, listMarkerColor: null,
+  listMarkerSuffix: null, listLevelNumFmts: null, listAbstractNumId: null,
+  listStartOverride: null,
+};
+
+/** Bereid de hele selectie voor; een ontbrekende definitie schrijft niets. */
+export function planList(session, target, kind) {
+  const all = session.paragraphs(target.range.story);
+  const paragraphs = all.slice(target.startParagraphIndex, target.endParagraphIndex + 1);
+  const definitions = session.materializeDocx()?.package.numbering;
+  const isKind = p => {
+    const n = p.numPr;
+    const resolved = n?.numId > 0 ? levelFor(definitions, n.numId, n.ilvl ?? 0) : null;
+    return resolved ? (resolved.level.numFmt === "bullet" ? "bullet" : resolved.level.numFmt === "none" ? null : "numbered") === kind : false;
+  };
+  if (paragraphs.length && paragraphs.every(p => isKind(p.properties))) {
+    // numId=0 onderdrukt ook een lijst die van de alineastijl is geërfd.
+    return paragraphs.map(p => ({ paraId: p.paraId, attrs: { ...emptyHints, numPr: { numId: 0, ilvl: 0 } } }));
+  }
+  const wanted = kind === "bullet" ? "bullet" : "decimal";
+  const previous = all[target.startParagraphIndex - 1]?.properties.numPr?.numId;
+  return paragraphs.map(p => {
+    const ilvl = p.properties.numPr?.ilvl ?? 0;
+    // Een bestaande passende instantie behouden; daarna aansluiten op de
+    // voorafgaande lijst, dan pas een andere passende definitie kiezen.
+    const ids = [p.properties.numPr?.numId, previous, ...(definitions?.nums ?? []).map(n => n.numId)];
+    let resolved, numId;
+    for (const id of ids) {
+      if (!(id > 0)) continue;
+      const candidate = levelFor(definitions, id, ilvl);
+      if (candidate?.level.numFmt === wanted) { resolved = candidate; numId = id; break; }
+    }
+    if (!resolved) throw new Error("The document has no compatible list definition. Choose a list format in the Lists dialog.");
+    const { level, instance, abstract, start } = resolved;
+    const font = level.rPr?.fontFamily?.ascii ?? level.rPr?.fontFamily?.hAnsi ?? null;
+    let marker = level.lvlText;
+    // De standaard Symbol-bullet is in OOXML een private-use-teken.
+    if (wanted === "bullet" && ["\uf0b7", "·"].includes(marker)) marker = "•";
+    return { paraId: p.paraId, attrs: {
+      ...emptyHints, numPr: { numId, ilvl },
+      listIsBullet: wanted === "bullet", listNumFmt: level.numFmt,
+      listMarker: marker, listMarkerHidden: level.rPr?.hidden ?? null,
+      listMarkerFontFamily: font, listMarkerFontSize: level.rPr?.fontSize != null ? level.rPr.fontSize / 2 : null,
+      listMarkerBold: level.rPr?.bold ?? null, listMarkerItalic: level.rPr?.italic ?? null,
+      listMarkerColor: level.rPr?.color ?? null, listMarkerSuffix: level.suffix ?? null,
+      listLevelNumFmts: Array.from({ length: ilvl + 1 }, (_, i) => levelFor(definitions, instance.numId, i)?.level.numFmt ?? "decimal"),
+      listAbstractNumId: abstract?.abstractNumId ?? instance.abstractNumId,
+      listStartOverride: start ?? null,
+    } };
+  });
+}
+
+export function applyDocumentList(session, target, kind, author) {
+  const plan = planList(session, target, kind);
+  for (const { paraId, attrs } of plan) session.setParagraphAttrs({ story: target.range.story, start: { paraId, offset: 0 }, end: { paraId, offset: 0 } }, attrs, author);
+}
