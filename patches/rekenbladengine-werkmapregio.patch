new file mode 100644
index 0000000..d44ba19
--- /dev/null
+++ b/crates/betteroffice-xlsx/tests/regionale_batchinvoer.rs
@@ -0,0 +1,179 @@
+use betteroffice_xlsx::{
+    CalculationOptions, CellRange, CellRef, CellValue, DateSystem, EditRequest,
+    NumberFormatMutation, Sheet, SheetId, Workbook, WorkbookModel,
+};
+use serde_json::{Value, json};
+
+fn at(a1: &str) -> CellRef {
+    CellRef::parse_a1(a1).unwrap()
+}
+fn boek(regio: Option<&str>, datumstelsel: DateSystem) -> Workbook {
+    let mut model = WorkbookModel {
+        sheets: vec![Sheet::new("Gegevens")],
+        date_system: datumstelsel,
+        ..Default::default()
+    };
+    if let Some(regio) = regio {
+        model.defined_names.push(xlsx_model::DefinedName {
+            name: "_OpenAEC_NumberLocale".into(),
+            formula: format!("\"{regio}\""),
+            local_sheet: None,
+            hidden: true,
+        });
+    }
+    Workbook::from_model(model).unwrap()
+}
+fn request(boek: &Workbook, a1: &str, inputs: Value, localized: Option<Value>) -> Value {
+    let mut stap = json!({"op":"setCellInputs","target":{"sheetId":"sheet:0","range":{"kind":"a1","a1":a1}},"inputs":inputs});
+    if let Some(localized) = localized {
+        stap["localized"] = localized;
+    }
+    json!({"expectVersion":boek.version(),"steps":[stap]})
+}
+fn uitvoeren(boek: &mut Workbook, r: Value) {
+    let request: EditRequest = serde_json::from_value(r).unwrap();
+    assert!(boek.apply_edits(&request).unwrap().unwrap().applied);
+}
+fn waarde(boek: &Workbook, a1: &str) -> CellValue {
+    boek.model().sheets[0]
+        .cell(at(a1))
+        .map(|c| c.value.clone())
+        .unwrap_or_default()
+}
+fn getal(n: f64) -> CellValue {
+    CellValue::Number { value: n }
+}
+fn getoond(boek: &Workbook, a1: &str) -> String {
+    boek.model().sheets[0]
+        .cell(at(a1))
+        .map(|c| xlsx_render::workbook_display_text(boek.model(), c))
+        .unwrap_or_default()
+}
+
+#[test]
+fn bestaande_canonieke_batchinvoer_blijft_ongewijzigd() {
+    let mut b = boek(Some("nl-NL"), DateSystem::V1900);
+    let r = request(&b, "A1", json!([["1.234"]]), None);
+    uitvoeren(&mut b, r);
+    assert_eq!(waarde(&b, "A1"), getal(1.234));
+}
+#[test]
+fn regionale_batch_bewaart_getal_datum_en_procent_in_een_transactie() {
+    let mut b = boek(Some("nl-NL"), DateSystem::V1900);
+    let r = request(
+        &b,
+        "A1:C1",
+        json!([["1.234", "1-1-2026", "15%"]]),
+        Some(json!(true)),
+    );
+    uitvoeren(&mut b, r);
+    assert_eq!(waarde(&b, "A1"), getal(1234.0));
+    // 01-01-2026 is datumgetal 46023 in het bestaande stelsel 1900.
+    assert_eq!(waarde(&b, "B1"), getal(46023.0));
+    assert_eq!(waarde(&b, "C1"), getal(0.15));
+    assert_eq!(getoond(&b, "B1"), "01-01-2026");
+    assert_eq!(getoond(&b, "C1"), "15%");
+    b.undo(CalculationOptions::default()).unwrap();
+    for a1 in ["A1", "B1", "C1"] {
+        assert_eq!(waarde(&b, a1), CellValue::Empty);
+    }
+    b.redo(CalculationOptions::default()).unwrap();
+    assert_eq!(getoond(&b, "B1"), "01-01-2026");
+    assert_eq!(getoond(&b, "C1"), "15%");
+    let bytes = b.save().unwrap();
+    let heropend = Workbook::open(&bytes).unwrap();
+    assert_eq!(getoond(&heropend, "B1"), "01-01-2026");
+    assert_eq!(getoond(&heropend, "C1"), "15%");
+}
