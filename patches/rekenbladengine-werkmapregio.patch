new file mode 100644
index 0000000..8e17b63
--- /dev/null
+++ b/crates/xlsx-model/src/numfmt/locale.rs
@@ -0,0 +1,433 @@
+// Vaste regiogegevens uit Intl (Node 24.22.1, ICU 78.3).
+// Engelse maandafkortingen behouden de bestaande drielettervorm.
+// De kalender is expliciet Gregoriaans; dag- en maandnamen zijn geen normtekst.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct NumberLocale(usize);
+
+struct LocaleData {
+    tag: &'static str,
+    decimal: &'static str,
+    group: &'static str,
+    months: [&'static str; 12],
+    months_short: [&'static str; 12],
+    days: [&'static str; 7],
+    days_short: [&'static str; 7],
+    am: &'static str,
+    pm: &'static str,
+}
+
+impl NumberLocale {
+    pub fn from_tag(tag: &str) -> Option<Self> {
+        let tag = tag.replace('_', "-");
+        LOCALES
+            .iter()
+            .position(|l| l.tag.eq_ignore_ascii_case(&tag))
+            .map(Self)
+    }
+    pub fn tag(self) -> &'static str {
+        self.data().tag
+    }
+    pub(super) fn from_marker(marker: &str) -> Option<Self> {
+        if let Ok(lcid) = u32::from_str_radix(marker, 16) {
+            match lcid & 0xffff {
+                0x809 => Some(Self(0)),
+                0x409 => Some(Self(1)),
+                0x413 => Some(Self(2)),
+                0x407 => Some(Self(3)),
+                0x40c => Some(Self(4)),
+                0x40a | 0xc0a => Some(Self(5)),
+                0x410 => Some(Self(6)),
+                0x416 => Some(Self(7)),
+                0x804 => Some(Self(8)),
+                0x454 => Some(Self(9)),
+                _ => None,
+            }
+        } else {
+            Self::from_tag(marker)
+        }
+    }
+    fn data(self) -> &'static LocaleData {
+        &LOCALES[self.0]
+    }
+    pub fn decimal(self) -> &'static str {
+        self.data().decimal
+    }
+    pub fn group(self) -> &'static str {
+        self.data().group
+    }
+    pub(super) fn month(self, index: usize, short: bool) -> &'static str {
+        if short {
+            self.data().months_short[index]
+        } else {
+            self.data().months[index]
+        }
+    }
+    pub(super) fn day(self, index: usize, short: bool) -> &'static str {
+        if short {
+            self.data().days_short[index]
+        } else {
+            self.data().days[index]
+        }
+    }
+    pub(super) fn period(self, morning: bool) -> &'static str {
+        if morning {
+            self.data().am
+        } else {
+            self.data().pm
+        }
+    }
+    pub(super) fn english(self) -> bool {
+        self.0 < 2
+    }
+}
