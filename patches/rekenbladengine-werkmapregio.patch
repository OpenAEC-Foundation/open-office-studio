+    assert_eq!(getoond(&boek, "A1"), "1\u{202f}234,50");
+    assert_eq!(getoond(&boek, "B1"), "1\u{202f}234,50");
+    boek.undo(CalculationOptions::default()).unwrap();
+    assert_eq!(getoond(&boek, "A1"), "1.234,50");
+    assert_eq!(getoond(&boek, "B1"), "1.234,50");
+    boek.redo(CalculationOptions::default()).unwrap();
+    assert_eq!(getoond(&boek, "A1"), "1\u{202f}234,50");
+    assert_eq!(boek.model().styles, stijl);
+    let bewaard = boek.save().unwrap();
+    let heropend = Workbook::open(&bewaard).unwrap();
+    assert_eq!(getoond(&heropend, "A1"), "1\u{202f}234,50");
+    assert_eq!(getoond(&heropend, "B1"), "1\u{202f}234,50");
+    assert_eq!(
+        heropend.model().sheets[0].cell(at("A1")).unwrap().value,
+        getal(1234.5)
+    );
+    assert_eq!(
+        heropend
+            .model()
+            .defined_names
+            .iter()
+            .find(|n| n.name == REGIO)
+            .unwrap()
+            .formula,
+        "\"fr-FR\""
+    );
