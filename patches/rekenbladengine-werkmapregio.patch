+#[test]
+fn invoer_wordt_in_een_stap_met_notatie_bewaard_en_ongedaan_gemaakt() {
+    for (raw, value, display) in [
+        ("12,5", 12.5, "12,5"),
+        ("1.234", 1234.0, "1234"),
+        ("1.234,50", 1234.5, "1234,5"),
+        ("15%", 0.15, "15%"),
+        ("12,5%", 0.125, "12,5%"),
+        ("€ 1.234,50", 1234.5, "€ 1.234,50"),
+        ("1-1-2026", 46023.0, "01-01-2026"),
+        ("14:30", 14.5 / 24.0, "14:30"),
+    ] {
+        let mut boek = bestand();
+        regio(&mut boek, "nl-NL");
+        boek.edit_cell(SheetId(0), at("C1"), raw, CalculationOptions::default())
+            .unwrap();
+        assert_eq!(
+            boek.model().sheets[0].cell(at("C1")).unwrap().value,
+            getal(value),
+            "{raw}"
+        );
+        assert_eq!(getoond(&boek, "C1"), display, "{raw}");
+        let style = boek.model().sheets[0].cell(at("C1")).unwrap().style;
+        boek.undo(CalculationOptions::default()).unwrap();
+        assert!(
+            boek.model().sheets[0]
+                .cell(at("C1"))
+                .is_none_or(|c| c.value == CellValue::Empty)
+        );
+        boek.redo(CalculationOptions::default()).unwrap();
+        assert_eq!(getoond(&boek, "C1"), display, "Redo {raw}");
+        assert_eq!(boek.model().sheets[0].cell(at("C1")).unwrap().style, style);
+        let bytes = boek.save().unwrap();
+        assert_eq!(
+            getoond(&Workbook::open(&bytes).unwrap(), "C1"),
+            display,
+            "heropenen {raw}"
+        );
+    }
