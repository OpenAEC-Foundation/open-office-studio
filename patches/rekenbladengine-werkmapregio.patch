+#[test]
+fn grote_naamtabel_gebruikt_dezelfde_regio_voor_lezen_export_en_bulkbewerking() {
+    let mut model = bestand().model().clone();
+    model.sheets[0] = Sheet::new("Gegevens");
+    for row in 0..2000 {
+        model.sheets[0].set_cell(
+            CellRef::new(row, 0),
+            Cell {
+                value: getal(12.5),
+                ..Default::default()
+            },
+        );
+    }
+    model.defined_names = (0..40_000)
+        .map(|i| xlsx_model::DefinedName {
+            name: format!("_Proef{i}"),
+            formula: "1".into(),
+            local_sheet: None,
+            hidden: true,
+        })
+        .collect();
+    model.defined_names.push(xlsx_model::DefinedName {
+        name: REGIO.into(),
+        formula: "\"nl-NL\"".into(),
+        local_sheet: None,
+        hidden: true,
+    });
+    let mut boek = Workbook::from_model(model).unwrap();
+    let request = serde_json::from_value(serde_json::json!({
+        "ranges": [{"sheetId":"sheet:0","range":{"kind":"a1","a1":"A1:A2000"}}]
+    }))
+    .unwrap();
+    let lezing = boek.read_cells(&request).unwrap().unwrap();
+    assert_eq!(lezing.ranges[0].cells.len(), 2000);
+    assert!(
+        lezing.ranges[0]
+            .cells
+            .iter()
+            .all(|r| r[0].display_text == "12,5")
+    );
+    let invoer = boek
+        .range_cells(SheetId(0), CellRange::new(at("A1"), at("A2000")))
+        .unwrap();
+    assert!(invoer.iter().all(|r| r[0].input == "12,5"));
+    let options = serde_json::from_value(serde_json::json!({
+        "scope":[{"sheet":0,"range":"A1:A2000"}], "maxCells":2000,
+        "includeDefinedNames":false, "includeHiddenSheets":true
+    }))
+    .unwrap();
+    let export = boek.export_structured(&options).unwrap().unwrap();
+    assert!(
+        !export.content.sheets.is_empty(),
+        "{:?}",
+        export.content.diagnostics
+    );
+    let cellen = &export.content.sheets[0].cells;
+    assert_eq!(cellen.len(), 2000);
+    assert!(cellen.iter().all(|c| c.display_text == "12,5"));
+    let edits = (0..2000)
+        .map(|row| betteroffice_xlsx::CellInput {
+            cell: CellRef::new(row, 0),
+            input: "13,5".into(),
+        })
+        .collect::<Vec<_>>();
+    boek.edit_cells(SheetId(0), &edits, CalculationOptions::default())
+        .unwrap();
+    assert_eq!(getoond(&boek, "A2000"), "13,5");
+    boek.edit_cell(
+        SheetId(0),
+        at("B1"),
+        "=TEXT(A2000,\"0.0\")",
+        CalculationOptions::default(),
+    )
+    .unwrap();
+    assert_eq!(getoond(&boek, "B1"), "13,5");
+}
