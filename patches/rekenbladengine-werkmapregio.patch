diff --git a/crates/xlsx-ops/src/input/locale.rs b/crates/xlsx-ops/src/input/locale.rs
new file mode 100644
index 0000000..d34e23b
--- /dev/null
+++ b/crates/xlsx-ops/src/input/locale.rs
@@ -0,0 +1,147 @@
+use super::{ParsedInput, parse_input_with_context, parse_timestamp};
+use xlsx_model::{DateSystem, FormatCode, numfmt::NumberLocale};
+
+/// Invoer uit het raster. Een datum blijft een datumgetal; alleen de passende
+/// notatie wordt voorgesteld, uitsluitend bij een Algemene celnotatie.
+pub fn parse_input_in_locale(
+    input: &str,
+    format: FormatCode<'_>,
+    date_system: DateSystem,
+    now_serial: Option<f64>,
+    locale: NumberLocale,
+) -> (ParsedInput, Option<String>) {
+    if input.is_empty()
+        || input.starts_with(['=', '\''])
+        || input.eq_ignore_ascii_case("true")
+        || input.eq_ignore_ascii_case("false")
+        || matches!(format, FormatCode::Builtin(49) | FormatCode::Custom("@"))
+    {
+        return (
+            parse_input_with_context(input, format, date_system, now_serial).0,
+            None,
+        );
+    }
+    let general = matches!(format, FormatCode::Builtin(0))
+        || matches!(format, FormatCode::Custom(code) if code.eq_ignore_ascii_case("general"));
+    let raw = input.trim();
+    if let Some((value, pattern)) = typed_number(raw, locale) {
+        return (ParsedInput::Number(value), pattern.filter(|_| general));
+    }
+    // Een expliciete datumcode bepaalt de invoervolgorde; een Algemene cel
+    // volgt de bestandsregio. De klok is de bestaande, aangeleverde rekenklok.
+    let day_first = super::date_order(&format).unwrap_or(locale.tag() != "en-US");
+    if let Some((value, id)) = parse_timestamp(raw, day_first, date_system, now_serial) {
+        let pattern = match id {
+            14 if day_first => "dd-mm-yyyy",
+            14 => "mm/dd/yyyy",
+            22 if day_first => "dd-mm-yyyy h:mm",
+            22 => "mm/dd/yyyy h:mm",
+            other => xlsx_model::numfmt::builtin_format_code(other).unwrap_or("General"),
+        };
+        return (
+            ParsedInput::Number(value),
+            general.then(|| pattern.to_owned()),
+        );
+    }
+    (ParsedInput::Text(input.to_owned()), None)
+}
+
+fn typed_number(raw: &str, locale: NumberLocale) -> Option<(f64, Option<String>)> {
+    let (body, negative) = match (raw.strip_prefix('('), raw.strip_suffix(')')) {
+        (Some(left), Some(_)) => (left.strip_suffix(')')?.trim(), true),
+        (None, None) => (raw, false),
+        _ => return None,
+    };
+    if negative && body.starts_with(['+', '-']) {
+        return None;
+    }
+    let (body, percentage) = match body.strip_suffix('%') {
+        Some(body) => (body.trim(), true),
+        None => (body, false),
+    };
+    let mut currency = None;
+    let mut number = body;
+    for symbol in ["CHF", "R$", "€", "$", "£", "¥", "₭"] {
+        if let Some(rest) = body
+            .strip_prefix(symbol)
+            .or_else(|| body.strip_suffix(symbol))
+        {
+            currency = Some(symbol);
+            number = rest.trim();
+            break;
+        }
+    }
+    if percentage && currency.is_some() {
+        return None;
+    }
+    let value = local_number(number, locale)? * if negative { -1.0 } else { 1.0 };
+    let pattern = if percentage {
+        let decimals = number
+            .split(locale.decimal())
+            .nth(1)
+            .map_or(0, |part| part.split(['e', 'E']).next().unwrap_or("").len());
+        Some(if decimals == 0 {
+            "0%".into()
+        } else {
+            format!("0.{}%", "0".repeat(decimals.min(30)))
+        })
+    } else {
+        currency.map(|symbol| format!("\"{symbol} \"#,##0.00"))
+    };
+    Some((if percentage { value / 100.0 } else { value }, pattern))
+}
+
+fn local_number(raw: &str, locale: NumberLocale) -> Option<f64> {
+    let raw = raw.strip_prefix('+').unwrap_or(raw);
+    let (sign, raw) = raw.strip_prefix('-').map_or(("", raw), |r| ("-", r));
+    let mut exponent = raw.split(['e', 'E']);
+    let mantissa = exponent.next()?;
+    let power = exponent.next();
+    if exponent.next().is_some() {
+        return None;
+    }
+    if power.is_some_and(|s| {
+        let s = s.strip_prefix(['+', '-']).unwrap_or(s);
+        s.is_empty() || !s.bytes().all(|c| c.is_ascii_digit())
+    }) {
+        return None;
+    }
+    // Alle Franse spatievormen zijn gebruikelijke plak-/toetsenbordinvoer.
+    let mantissa = if locale.group() == "\u{202f}" {
+        mantissa.replace([' ', '\u{a0}'], "\u{202f}")
+    } else {
+        mantissa.to_owned()
+    };
+    let mut decimal = mantissa.split(locale.decimal());
+    let integer = decimal.next()?;
+    let fraction = decimal.next();
+    if decimal.next().is_some()
+        || fraction.is_some_and(|s| s.is_empty() || !s.bytes().all(|c| c.is_ascii_digit()))
+    {
+        return None;
+    }
+    let groups: Vec<_> = integer.split(locale.group()).collect();
+    if groups.len() > 1
+        && (groups[0].is_empty() || groups[0].len() > 3 || groups[1..].iter().any(|s| s.len() != 3))
+    {
+        return None;
+    }
+    if groups
+        .iter()
+        .any(|s| !s.bytes().all(|c| c.is_ascii_digit()))
+        || (integer.is_empty() && fraction.is_none())
+    {
+        return None;
+    }
+    let mut canonical = format!("{sign}{}", groups.concat());
+    if let Some(fraction) = fraction {
+        canonical.push('.');
+        canonical.push_str(fraction);
+    }
+    if let Some(power) = power {
+        canonical.push('e');
+        canonical.push_str(power);
+    }
+    let value: f64 = canonical.parse().ok()?;
+    value.is_finite().then_some(value)
+}
