+#[test]
+fn gesynchroniseerde_werkmap_behoudt_regio_en_weigert_verboden_structuurwijzigingen() {
+    let mut bron = bestand();
+    regio(&mut bron, "nl-NL");
+    let bytes = bron.save().unwrap();
+    let mut bron = Workbook::open_collaborative(&bytes, 6401).unwrap();
+    let mut peer = Workbook::open_collaborative(&bytes, 6402).unwrap();
+    // Naamdefinities wijzigen is al uitgesloten in deze samenwerkingsmodus.
+    // Een regiowijziging mag deze bestaande weigering niet omzeilen.
+    let resultaat = bron.apply_ops(
+        vec![Op::SetDefinedName {
+            name: REGIO.into(),
+            refers_to: "\"de-DE\"".into(),
+            scope: None,
+            hidden: Some(true),
+        }],
+        CalculationOptions::default(),
+    );
+    assert!(matches!(
+        resultaat,
+        Err(betteroffice_xlsx::Error::CollaborativeStructureOperation)
+    ));
+    bron.edit_cell(
+        SheetId(0),
+        at("A1"),
+        "2.345,60",
+        CalculationOptions::default(),
+    )
+    .unwrap();
+    let update = bron.encode_state_as_update_v1();
+    peer.apply_update_v1(&update, CalculationOptions::default())
+        .unwrap();
+    assert_eq!(getoond(&peer, "A1"), "2.345,60");
+    assert_eq!(getoond(&peer, "A2"), "donderdag 1 januari 2026");
+    assert_eq!(getoond(&peer, "B1"), "2.345,60");
+}
