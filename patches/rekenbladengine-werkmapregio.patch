+++ b/crates/xlsx-model/src/numfmt/regio_tests.rs
@@ -0,0 +1,135 @@
+use super::*;
+
+fn datum(code: &str) -> String {
+    // 01-01-2026 is donderdag; het bestaande datumstelsel geeft seriegetal 46023.
+    format_value(
+        &CellValue::Number { value: 46023.0 },
+        code,
+        DateSystem::V1900,
+    )
+    .text
+}
+
+#[test]
+fn nederlandse_landcode_gebruikt_nederlandse_dagnamen() {
+    assert_eq!(datum("[$-413]dddd d mmmm yyyy"), "donderdag 1 januari 2026");
+}
+#[test]
+fn taalcode_wordt_ook_herkend() {
+    assert_eq!(
+        datum("[$-nl-NL]dddd d mmmm yyyy"),
+        "donderdag 1 januari 2026"
+    );
+}
+#[test]
+fn korte_maandnaam_volgt_de_landcode() {
+    assert_eq!(datum("[$-0413]mmm"), "jan");
+}
+#[test]
+fn aangehaalde_tekst_blijft_ongewijzigd() {
+    assert_eq!(
+        datum("[$-413]\"January literal \"mmmm"),
+        "January literal januari"
+    );
+}
+#[test]
+fn onbekende_landcode_behoudt_de_bestaande_terugval() {
+    assert_eq!(datum("[$-FFFF]dddd d mmmm yyyy"), "Thursday 1 January 2026");
+}
+#[test]
+fn niet_gelokaliseerde_notatie_blijft_gelijk() {
+    assert_eq!(datum("dddd d mmmm yyyy"), "Thursday 1 January 2026");
+}
+
+fn getal(n: f64, code: &str, tag: &str) -> FormattedValue {
+    format_value_in_locale(
+        &CellValue::Number { value: n },
+        code,
+        DateSystem::V1900,
+        NumberLocale::from_tag(tag).unwrap(),
+    )
+}
+
+#[test]
+fn decimaal_en_groepering_volgen_de_werkmapregio() {
+    assert_eq!(getal(1234.5, "#,##0.00", "nl-NL").text, "1.234,50");
+    assert_eq!(getal(1234.5, "#,##0.00", "en-US").text, "1,234.50");
+    assert_eq!(getal(1234.5, "#,##0.00", "fr-FR").text, "1\u{202f}234,50");
+    assert_eq!(getal(12.5, "General", "nl-NL").text, "12,5");
+}
+
+#[test]
+fn valuta_taalcode_overschrijft_de_getalscheiding_niet() {
+    assert_eq!(
+        getal(1234.5, "[$€-407] #,##0.00", "nl-NL").text,
+        "€ 1.234,50"
+    );
+}
+
+#[test]
+fn letterlijke_getallen_blijven_bytegelijk() {
+    assert_eq!(
+        getal(1234.5, "0.00\" literal 1,234.50\"", "nl-NL").text,
+        "1234,50 literal 1,234.50"
+    );
+}
+
+#[test]
+fn procent_wetenschappelijk_en_breuken_behouden_hun_waarde() {
+    assert_eq!(getal(0.125, "0.00%", "nl-NL").text, "12,50%");
+    assert_eq!(getal(1234.5, "0.00E+00", "nl-NL").text, "1,23E+03");
+    assert_eq!(getal(1.5, "# ?/?", "nl-NL").text, "1 1/2");
+    let rood = getal(-1234.5, "#,##0.00;[Red](#,##0.00)", "nl-NL");
+    assert_eq!(rood.text, "(1.234,50)");
+    assert_eq!(rood.color.as_deref(), Some("#FF0000"));
+}
+
+#[test]
+fn franse_meerbyte_groepering_behoudt_de_opmaakposities() {
+    let v = getal(1234.5, "#,##0.00_)", "fr-FR");
+    assert_eq!(v.text, "1\u{202f}234,50 ");
+    assert_eq!(
+        v.layout,
+        vec![FormatPart {
+            offset: "1\u{202f}234,50".len(),
+            kind: FormatPartKind::Padding,
+            character: ')'
+        }]
+    );
+    for part in &v.layout {
+        assert!(v.text.is_char_boundary(part.offset));
+    }
+}
+
+#[test]
+fn de_parsecache_mengt_geen_werkmapregios() {
+    for _ in 0..300 {
+        assert_eq!(getal(1234.5, "#,##0.00", "nl-NL").text, "1.234,50");
+        assert_eq!(getal(1234.5, "#,##0.00", "en-US").text, "1,234.50");
+    }
+}
+
+#[test]
+fn niet_latijnse_maandnamen_worden_op_tekengrenzen_afgekort() {
+    assert_eq!(getal(46023.0, "mmmm", "zh-CN").text, "一月");
+    assert_eq!(getal(46023.0, "mmmmm", "zh-CN").text, "一");
+    let lao = getal(46023.0, "mmmmm_)", "lo-LA");
+    assert!(!lao.text.is_empty());
+    assert!(lao.text.is_char_boundary(lao.layout[0].offset));
+}
+
+#[test]
+fn expliciete_datumtaal_is_los_van_de_werkmapregio() {
+    assert_eq!(
+        getal(46023.0, "dddd d mmmm yyyy", "nl-NL").text,
+        "donderdag 1 januari 2026"
+    );
+    assert_eq!(
+        getal(46023.0, "[$-409]dddd d mmmm yyyy", "nl-NL").text,
+        "Thursday 1 January 2026"
+    );
+    assert_eq!(
+        getal(46023.0, "[$-407]dddd d mmmm yyyy", "nl-NL").text,
+        "Donnerstag 1 Januar 2026"
+    );
+}
