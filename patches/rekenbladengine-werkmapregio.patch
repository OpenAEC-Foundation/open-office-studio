+use betteroffice_xlsx::{
+    CalculationOptions, Cell, CellRange, CellRef, CellValue, DrawCmd, NumberFormatMutation, Sheet,
+    SheetId, Viewport, Workbook, WorkbookModel,
+};
+use xlsx_ops::Op;
+
+const REGIO: &str = "_OpenAEC_NumberLocale";
+fn at(naam: &str) -> CellRef {
+    CellRef::parse_a1(naam).unwrap()
+}
+fn getal(n: f64) -> CellValue {
+    CellValue::Number { value: n }
+}
+fn bestand() -> Workbook {
+    let mut blad = Sheet::new("Gegevens");
+    for (cel, waarde, formule) in [
+        ("A1", 1234.5, None),
+        ("A2", 46023.0, None),
+        ("A3", 0.15, None),
+        ("B1", 0.0, Some("TEXT(A1,\"#,##0.00\")")),
+    ] {
+        blad.set_cell(
+            at(cel),
+            Cell {
+                value: getal(waarde),
+                formula: formule.map(str::to_owned),
+                ..Default::default()
+            },
+        );
+    }
+    let mut boek = Workbook::from_model(WorkbookModel {
+        sheets: vec![blad],
+        ..Default::default()
+    })
+    .unwrap();
+    for (cel, code) in [
+        ("A1", "#,##0.00"),
+        ("A2", "dddd d mmmm yyyy"),
+        ("A3", "0.0%"),
+    ] {
+        boek.set_range_number_format(
+            SheetId(0),
+            CellRange::new(at(cel), at(cel)),
+            NumberFormatMutation::Custom {
+                pattern: code.into(),
+            },
+            CalculationOptions::default(),
+        )
+        .unwrap();
+    }
+    boek
+}
+fn regio(boek: &mut Workbook, tag: &str) {
+    boek.apply_ops(
+        vec![Op::SetDefinedName {
+            name: REGIO.into(),
+            refers_to: format!("\"{tag}\""),
+            scope: None,
+            hidden: Some(true),
+        }],
+        CalculationOptions::default(),
+    )
+    .unwrap();
+}
+fn getoond(boek: &Workbook, cel: &str) -> String {
+    xlsx_render::workbook_display_text(boek.model(), boek.model().sheets[0].cell(at(cel)).unwrap())
+}
+fn tekenlijst(boek: &Workbook) -> Vec<String> {
+    boek.display_list(&Viewport {
+        x: 0.0,
+        y: 0.0,
+        width: 640.0,
+        height: 300.0,
+    })
+    .unwrap()
+    .commands
+    .iter()
+    .filter_map(|cmd| match cmd {
+        DrawCmd::Text { text, .. } => Some(text.to_string()),
+        _ => None,
+    })
+    .collect()
+}
+#[test]
+fn bestanden_hebben_een_eigen_regio_voor_cijfers_datum_en_textformule() {
+    let mut nederlands = bestand();
+    let mut engels = bestand();
+    regio(&mut nederlands, "nl-NL");
+    regio(&mut engels, "en-US");
+    assert_eq!(getoond(&nederlands, "A1"), "1.234,50");
+    assert_eq!(getoond(&engels, "A1"), "1,234.50");
+    assert_eq!(getoond(&nederlands, "A2"), "donderdag 1 januari 2026");
+    assert_eq!(getoond(&engels, "A2"), "Thursday 1 January 2026");
+    assert_eq!(getoond(&nederlands, "A3"), "15,0%");
+    assert_eq!(getoond(&nederlands, "B1"), "1.234,50");
+    assert_eq!(getoond(&engels, "B1"), "1,234.50");
+    assert!(tekenlijst(&nederlands).iter().any(|s| s == "1.234,50"));
+    assert!(tekenlijst(&engels).iter().any(|s| s == "1,234.50"));
+    assert_eq!(
+        nederlands.model().sheets[0].cell(at("A1")).unwrap().value,
+        getal(1234.5)
+    );
+}
