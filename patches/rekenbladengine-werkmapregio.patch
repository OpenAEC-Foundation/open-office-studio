+
+    pub fn number_locale_setting(&self) -> Option<crate::numfmt::NumberLocale> {
+        self.defined_names
+            .iter()
+            .find(|name| {
+                name.local_sheet.is_none()
+                    && name.hidden
+                    && name.name.eq_ignore_ascii_case("_OpenAEC_NumberLocale")
+            })
+            .and_then(|name| name.formula.strip_prefix('"')?.strip_suffix('"'))
+            .and_then(crate::numfmt::NumberLocale::from_tag)
+    }
+
     pub fn sheet(&self, id: SheetId) -> Option<&Sheet> {
         self.sheets.get(id.0 as usize)
     }
