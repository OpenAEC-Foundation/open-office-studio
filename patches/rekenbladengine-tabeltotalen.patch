+use betteroffice_xlsx::{CalculationOptions, CellRef, CellValue, Op, Sheet, SheetId, Workbook, WorkbookModel};
+fn source() -> Workbook {
+    let mut model = WorkbookModel::default();
+    model.sheets.push(Sheet::new("Data"));
+    let mut w = Workbook::from_model(model).unwrap();
+    for (row, input) in ["2", "3", "text"].iter().enumerate() {
+        w.edit_cell(SheetId(0), CellRef::new(row as u32,0), input, CalculationOptions::default()).unwrap();
+    }
+    w
+}
+fn number(w: &Workbook, row: u32) -> f64 {
+    match w.model().sheets[0].cell(CellRef::new(row,2)).unwrap().value {
+        CellValue::Number{value} => value,
+        ref v => panic!("expected number, got {v:?}"),
+    }
+}
+#[test]
+fn hidden_rows_recalculate_totals_with_undo_redo_and_save_reopen() {
+    let mut w=source();
+    let codes=[109,103,101,105,104,102];
+    for (row,code) in codes.iter().enumerate() {
+        w.edit_cell(SheetId(0),CellRef::new(row as u32,2),&format!("=SUBTOTAL({code},A1:A3)"),CalculationOptions::default()).unwrap();
+    }
+    assert_eq!((0..6).map(|r|number(&w,r)).collect::<Vec<_>>(),vec![5.0,3.0,2.5,2.0,3.0,2.0]);
+    w.apply_ops(vec![Op::SetRowHeight{sheet:SheetId(0),row:1,height:Some(0.0)}],CalculationOptions::default()).unwrap();
+    assert_eq!((0..6).map(|r|number(&w,r)).collect::<Vec<_>>(),vec![2.0,2.0,2.0,2.0,2.0,1.0]);
+    w.undo(CalculationOptions::default()).unwrap();assert_eq!(number(&w,0),5.0);
+    w.redo(CalculationOptions::default()).unwrap();assert_eq!(number(&w,0),2.0);
+    let saved=w.save().unwrap();let reopened=Workbook::open(&saved).unwrap();assert_eq!(number(&reopened,0),2.0);
+}
+#[test]
+fn whole_columns_unions_and_all_hidden_keep_reference_types() {
+    let mut w=source();
+    w.edit_cell(SheetId(0),CellRef::new(0,2),"=SUBTOTAL(109,A:A)",CalculationOptions::default()).unwrap();
+    w.edit_cell(SheetId(0),CellRef::new(1,2),"=SUBTOTAL(109,(A1:A2,A3:A3))",CalculationOptions::default()).unwrap();
+    for row in 0..3 { w.apply_ops(vec![Op::SetRowHeight{sheet:SheetId(0),row,height:Some(0.0)}],CalculationOptions::default()).unwrap(); }
+    assert_eq!(number(&w,0),0.0);assert_eq!(number(&w,1),0.0);
+    w.undo(CalculationOptions::default()).unwrap();assert_eq!(number(&w,0),0.0);
+    w.undo(CalculationOptions::default()).unwrap();assert_eq!(number(&w,0),3.0);
+}
