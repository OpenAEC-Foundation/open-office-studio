+/// Keep reference semantics (text and booleans are not numeric literals),
+/// grouping consecutive visible rows instead of allocating one AST per cell.
+fn subtotal_visible_arguments(args: &[Expr], ctx: &EvalContext<'_>) -> Result<Vec<Expr>, ErrorValue> {
+    let Some(model) = ctx.provider.workbook() else { return Ok(args.to_vec()); };
+    let mut out = Vec::new();
+    for arg in args {
+        let areas = match union_areas(arg, ctx) {
+            Some(areas) => areas?,
+            None => match as_area(arg, ctx) {
+                Some(area) => vec![area],
+                None => { out.push(arg.clone()); continue; }
+            },
+        };
+        for area in areas {
+            let area = crate::eval::bound_area(area, ctx);
+            let Some(sheet) = model.sheet(area.sheet) else { return Err(ErrorValue::Ref); };
+            if !ctx.consume_cells(area.rows as u64) { return Err(ErrorValue::Num); }
+            let mut start = None;
+            for offset in 0..=area.rows {
+                let row = area.start.row + offset as u32;
+                let visible = offset < area.rows && !sheet.row_hidden(row);
+                if visible { start.get_or_insert(row); }
+                else if let Some(first) = start.take() {
+                    if area.cols > 0 {
+                        out.push(Expr::Range {
+                            sheet: Some(sheet.name.clone()),
+                            range: xlsx_model::CellRange {
+                                start: xlsx_model::CellRef::new(first, area.start.col),
+                                end: xlsx_model::CellRef::new(row - 1, area.start.col + area.cols as u32 - 1),
+                            },
+                        });
+                    }
+                }
+            }
+        }
+    }
+    Ok(out)
+}
