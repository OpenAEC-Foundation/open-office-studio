index 0000000..f58dad6
--- /dev/null
+++ b/crates/ooxml-drawingml/src/chart/linear_trend.rs
@@ -0,0 +1,164 @@
+#[derive(Debug)]
+pub(super) struct LinearFit {
+    pub min: f64,
+    pub max: f64,
+    center: f64,
+    unit: f64,
+    mean_x: f64,
+    mean_y: f64,
+    slope: f64,
+    scale: f64,
+}
+
+impl LinearFit {
+    pub fn at(&self, x: f64) -> Option<f64> {
+        let y =
+            (self.mean_y + self.slope * ((x - self.center) / self.unit - self.mean_x)) * self.scale;
+        y.is_finite().then_some(y)
+    }
+}
+
+pub(super) fn linear_fit(points: &[(f64, f64)], intercept: Option<f64>) -> Option<LinearFit> {
+    if points.len() < 2 || points.iter().any(|(x, y)| !x.is_finite() || !y.is_finite()) {
+        return None;
+    }
+    let min = points.iter().map(|p| p.0).fold(f64::INFINITY, f64::min);
+    let max = points.iter().map(|p| p.0).fold(f64::NEG_INFINITY, f64::max);
+    if max <= min || intercept.is_some_and(|n| !n.is_finite()) {
+        return None;
+    }
+    let center = if intercept.is_some() {
+        0.0
+    } else {
+        min / 2.0 + max / 2.0
+    };
+    let unit = if intercept.is_some() {
+        min.abs().max(max.abs())
+    } else {
+        max / 2.0 - min / 2.0
+    };
+    if !unit.is_finite() || unit <= 0.0 {
+        return None;
+    }
+    let scale = points
+        .iter()
+        .map(|p| p.1.abs())
+        .fold(intercept.unwrap_or(0.0).abs(), f64::max)
+        .max(f64::MIN_POSITIVE);
+    let count = points.len() as f64;
+    let (mean_x, mean_y) = match intercept {
+        Some(value) => (0.0, value / scale),
+        None => (
+            points.iter().map(|p| (p.0 - center) / unit / count).sum(),
+            points.iter().map(|p| p.1 / scale / count).sum(),
+        ),
+    };
+    let (mut covariance, mut variance) = (0.0, 0.0);
+    for &(x, y) in points {
+        let dx = (x - center) / unit - mean_x;
+        covariance += dx * (y / scale - mean_y);
+        variance += dx * dx;
+    }
+    if variance <= 0.0 || !variance.is_finite() {
+        return None;
+    }
+    let slope = covariance / variance;
+    slope.is_finite().then_some(LinearFit {
+        min,
+        max,
+        center,
+        unit,
+        mean_x,
+        mean_y,
+        slope,
+        scale,
+    })
+}
+
+pub(super) fn clip_unit_line(a: (f64, f64), b: (f64, f64)) -> Option<((f64, f64), (f64, f64))> {
+    let delta = (b.0 - a.0, b.1 - a.1);
+    if [a.0, a.1, b.0, b.1, delta.0, delta.1]
+        .iter()
+        .any(|n| !n.is_finite())
+    {
+        return None;
+    }
+    let (mut lo, mut hi): (f64, f64) = (0.0, 1.0);
+    for (p, q) in [
+        (-delta.0, a.0),
+        (delta.0, 1.0 - a.0),
+        (-delta.1, a.1),
+        (delta.1, 1.0 - a.1),
+    ] {
+        if p == 0.0 {
+            if q < 0.0 {
+                return None;
+            }
+        } else if p < 0.0 {
+            lo = lo.max(q / p);
+        } else {
+            hi = hi.min(q / p);
+        }
+        if lo > hi {
+            return None;
+        }
+    }
+    let at = |t: f64| {
+        (
+            (a.0 + delta.0 * t).clamp(0.0, 1.0),
+            (a.1 + delta.1 * t).clamp(0.0, 1.0),
+        )
+    };
+    Some((at(lo), at(hi)))
+}
