+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn least_squares_uses_original_x_coordinates() {
+        let fit = linear_fit(&[(1.0, 2.0), (2.0, 6.0), (3.0, 4.0)], None).unwrap();
+        assert!((fit.at(1.0).unwrap() - 3.0).abs() < 1e-12);
+        assert!((fit.at(3.0).unwrap() - 5.0).abs() < 1e-12);
+        let gaps = linear_fit(&[(1.0, 3.0), (3.0, 7.0)], None).unwrap();
+        assert!((gaps.at(2.0).unwrap() - 5.0).abs() < 1e-12);
+        let scatter = linear_fit(&[(10.0, 21.0), (30.0, 61.0), (50.0, 101.0)], None).unwrap();
+        assert!((scatter.at(20.0).unwrap() - 41.0).abs() < 1e-10);
+    }
+
+    #[test]
+    fn fixed_intercepts_are_constrained_fits() {
+        let fit = linear_fit(&[(1.0, 2.0), (2.0, 6.0), (3.0, 4.0)], Some(0.0)).unwrap();
+        assert_eq!(fit.at(0.0), Some(0.0));
+        assert!((fit.at(1.0).unwrap() - 13.0 / 7.0).abs() < 1e-12);
+        let offset = linear_fit(&[(1.0, 2.0), (2.0, 6.0), (3.0, 4.0)], Some(2.0)).unwrap();
+        assert!((offset.at(0.0).unwrap() - 2.0).abs() < 1e-12);
+        assert!((offset.at(3.0).unwrap() - 5.0).abs() < 1e-12);
+    }
+
+    #[test]
+    fn large_translated_and_zero_data_stay_finite() {
+        let fit = linear_fit(&[(1e12, 2.0), (1e12 + 1.0, 5.0), (1e12 + 2.0, 8.0)], None).unwrap();
+        assert!((fit.at(1e12 + 1.5).unwrap() - 6.5).abs() < 1e-10);
+        let zero = linear_fit(&[(1.0, 0.0), (2.0, 0.0)], None).unwrap();
+        assert_eq!(zero.at(1.5), Some(0.0));
+        assert!(linear_fit(&[(1.0, 2.0)], None).is_none());
+        assert!(linear_fit(&[(1.0, 2.0), (1.0, 4.0)], None).is_none());
+        assert!(linear_fit(&[(1.0, f64::NAN), (2.0, 4.0)], None).is_none());
+    }
+
+    #[test]
+    fn clipping_intersects_instead_of_flattening_a_forecast() {
+        assert_eq!(
+            clip_unit_line((-1.0, -1.0), (2.0, 2.0)),
+            Some(((0.0, 0.0), (1.0, 1.0)))
+        );
+        assert_eq!(
+            clip_unit_line((0.0, -1.0), (1.0, 1.0)),
+            Some(((0.5, 0.0), (1.0, 1.0)))
+        );
+        assert_eq!(clip_unit_line((0.0, 2.0), (1.0, 2.0)), None);
+        assert_eq!(clip_unit_line((f64::INFINITY, 0.0), (1.0, 1.0)), None);
+    }
+}
