+fn parse_trendlines<E: ChartXml>(series: &E) -> Vec<ChartTrendline> {
+    children(series, "trendline")
+        .take(8)
+        .filter_map(|trend| {
+            if val_attr(child(trend, "trendlineType")) != Some("linear") {
+                return None;
+            }
+            let number = |name: &str| match child(trend, name) {
+                Some(element) => parse_number(val_attr(Some(element))).map(Some),
+                None => Some(None),
+            };
+            let forward = number("forward")?;
+            let backward = number("backward")?;
+            if forward.is_some_and(|n| n < 0.0) || backward.is_some_and(|n| n < 0.0) {
+                return None;
+            }
+            let properties = child(trend, "spPr");
+            Some(ChartTrendline {
+                kind: "linear".to_owned(),
+                intercept: number("intercept")?,
+                forward,
+                backward,
+                line: parse_line(properties),
+                dash: properties
+                    .and_then(|p| child(p, "ln"))
+                    .and_then(|line| val_attr(child(line, "prstDash")))
+                    .map(str::to_owned),
+            })
+        })
+        .collect()
+}
