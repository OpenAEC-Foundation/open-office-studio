+fn emit_linear_trendlines<S: PlotSink + ?Sized>(
+    ops: &mut Emitter<'_, S>,
+    family: PlotFamily<'_>,
+    plot: PlotArea,
+    remaining: &mut usize,
+) {
+    if !matches!(family.chart_type, "line" | "scatter") || family.stacking() != Stacking::None {
+        return;
+    }
+    let scatter = family.chart_type == "scatter";
+    let y_scale = value_scale(family);
+    let x_scale = scatter.then(|| scatter_x_scale(family, plot));
+    if y_scale.log_base.is_some() || x_scale.is_some_and(|scale| scale.log_base.is_some()) {
+        return;
+    }
+    let count = category_count(family.series);
+    for (series_index, series) in family.series.iter().enumerate() {
+        if ops.exhausted() {
+            return;
+        }
+        if series.series.trendlines.is_empty() {
+            continue;
+        }
+        let length = series.length();
+        if length > *remaining {
+            continue;
+        }
+        *remaining -= length;
+        let points: Vec<(f64, f64)> = (0..length)
+            .filter_map(|i| {
+                if scatter {
+                    series.xy_value(i)
+                } else {
+                    Some((i as f64 + 1.0, series.data_value(i)?))
+                }
+            })
+            .collect();
+        for trend in series.series.trendlines.iter().take(8) {
+            if ops.exhausted() {
+                return;
+            }
+            if trend.kind != "linear" || trend.line.as_ref().is_some_and(|line| line.none) {
+                continue;
+            }
+            let Some(fit) = linear_fit(&points, trend.intercept) else {
+                continue;
+            };
+            let backward = trend.backward.unwrap_or(0.0);
+            let forward = trend.forward.unwrap_or(0.0);
+            if !backward.is_finite() || !forward.is_finite() || backward < 0.0 || forward < 0.0 {
+                continue;
+            }
+            let (lo, hi) = (fit.min - backward, fit.max + forward);
+            let (Some(y_lo), Some(y_hi)) = (fit.at(lo), fit.at(hi)) else {
+                continue;
+            };
+            let project = |x: f64, y: f64| {
+                let x = if let Some(scale) = x_scale {
+                    let fraction = scale.fraction(x);
+                    if scale.reversed {
+                        1.0 - fraction
+                    } else {
+                        fraction
+                    }
+                } else {
+                    let position = if family.category_axis.is_some_and(|axis| axis.reversed) {
+                        count as f64 - x
+                    } else {
+                        x - 1.0
+                    };
+                    if family.axis.and_then(|axis| axis.cross_between) == Some("midCat") {
+                        position / count.saturating_sub(1).max(1) as f64
+                    } else {
+                        (position + 0.5) / count.max(1) as f64
+                    }
+                };
+                let fraction = y_scale.fraction(y);
+                (
+                    x,
+                    if y_scale.reversed {
+                        fraction
+                    } else {
+                        1.0 - fraction
+                    },
+                )
+            };
+            let Some((a, b)) = clip_unit_line(project(lo, y_lo), project(hi, y_hi)) else {
+                continue;
+            };
+            let a = (plot.x + a.0 * plot.w, plot.y + a.1 * plot.h);
+            let b = (plot.x + b.0 * plot.w, plot.y + b.1 * plot.h);
+            let color = trend
+                .line
+                .as_ref()
+                .and_then(|line| line.color.as_deref())
+                .map(hex)
+                .unwrap_or_else(|| series_color(Some(series.series), series_index));
+            let width = line_width(
+                trend.line.as_ref().and_then(|line| line.width_emu),
+                DEFAULT_SERIES_LINE_PX,
+            );
+            let dashed = trend.dash.as_deref().filter(|dash| *dash != "solid");
+            if let Some(dash) = dashed {
+                let length = (b.0 - a.0).hypot(b.1 - a.1);
+                let mark = if matches!(dash, "dot" | "sysDot") {
+                    width
+                } else {
+                    width * 4.0
+                };
+                let period = (mark + width * 2.0).max(length / 2048.0);
+                let count = (length / period).ceil().min(2048.0) as usize;
+                for i in 0..count {
+                    if ops.exhausted() {
+                        break;
+                    }
+                    let lo = i as f64 * period / length;
+                    let hi = ((i as f64 * period + mark) / length).min(1.0);
+                    push_line(
+                        ops,
+                        a.0 + (b.0 - a.0) * lo,
+                        a.1 + (b.1 - a.1) * lo,
+                        a.0 + (b.0 - a.0) * hi,
+                        a.1 + (b.1 - a.1) * hi,
+                        &color,
+                        width,
+                    );
+                }
+            } else {
+                push_line(ops, a.0, a.1, b.0, b.1, &color, width);
+            }
+        }
+    }
+}
