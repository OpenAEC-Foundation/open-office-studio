+use betteroffice_xlsx::{
+    CalculationOptions, CellRange, CellRef, DisplayList, DrawCmd, PrintMetrics, SheetId, Viewport,
+    Workbook,
+};
+
+const FIXTURE: &[u8] = include_bytes!("../../../packages/xlsx/test-fixtures/charts.xlsx");
+const CHART: &str = "xl/charts/chart1.xml";
+
+fn at(row: u32, col: u32) -> CellRef {
+    CellRef {
+        row,
+        col,
+        abs_row: false,
+        abs_col: false,
+    }
+}
+
+fn fixture(scatter: bool) -> Vec<u8> {
+    let mut book = Workbook::open(FIXTURE).unwrap();
+    let name = book.model().sheet(SheetId(0)).unwrap().name.clone();
+    for (index, value) in [2, 6, 4].iter().enumerate() {
+        book.edit_cell(
+            SheetId(0),
+            at(index as u32 + 1, 0),
+            &(index + 1).to_string(),
+            CalculationOptions::default(),
+        )
+        .unwrap();
+        book.edit_cell(
+            SheetId(0),
+            at(index as u32 + 1, 1),
+            &value.to_string(),
+            CalculationOptions::default(),
+        )
+        .unwrap();
+    }
+    let mut parts = ooxml_opc::unzip_parts(&book.save().unwrap()).unwrap();
+    let (family, categories, values, axis) = if scatter {
+        ("scatterChart", "xVal", "yVal", "valAx")
+    } else {
+        ("lineChart", "cat", "val", "catAx")
+    };
+    let xml = format!(
+        r#"<c:chartSpace xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><c:chart><c:plotArea><c:layout><c:manualLayout><c:layoutTarget val="inner"/><c:xMode val="factor"/><c:yMode val="factor"/><c:wMode val="factor"/><c:hMode val="factor"/><c:x val="0.1"/><c:y val="0.1"/><c:w val="0.8"/><c:h val="0.8"/></c:manualLayout></c:layout><c:{family}><c:grouping val="standard"/><c:scatterStyle val="lineMarker"/><c:ser><c:idx val="0"/><c:order val="0"/><c:trendline><c:spPr><a:ln w="19050"><a:solidFill><a:srgbClr val="FF00EE"/></a:solidFill></a:ln></c:spPr><c:trendlineType val="linear"/></c:trendline><c:{categories}><c:numRef><c:f>'{name}'!$A$2:$A$4</c:f><c:numCache><c:ptCount val="3"/><c:pt idx="0"><c:v>1</c:v></c:pt><c:pt idx="1"><c:v>2</c:v></c:pt><c:pt idx="2"><c:v>3</c:v></c:pt></c:numCache></c:numRef></c:{categories}><c:{values}><c:numRef><c:f>'{name}'!$B$2:$B$4</c:f><c:numCache><c:ptCount val="3"/><c:pt idx="0"><c:v>2</c:v></c:pt><c:pt idx="1"><c:v>6</c:v></c:pt><c:pt idx="2"><c:v>4</c:v></c:pt></c:numCache></c:numRef></c:{values}></c:ser><c:axId val="10"/><c:axId val="20"/></c:{family}><c:{axis}><c:axId val="10"/><c:scaling><c:orientation val="minMax"/><c:min val="0"/><c:max val="4"/></c:scaling><c:axPos val="b"/><c:crossAx val="20"/></c:{axis}><c:valAx><c:axId val="20"/><c:scaling><c:orientation val="minMax"/><c:min val="0"/><c:max val="8"/></c:scaling><c:axPos val="l"/><c:crossAx val="10"/><c:crossBetween val="between"/></c:valAx></c:plotArea><c:legend><c:legendPos val="r"/></c:legend></c:chart></c:chartSpace>"#
+    );
+    *parts.iter_mut().find(|(path, _)| path == CHART).unwrap() =
+        (CHART.to_owned(), xml.into_bytes());
+    parts.push((
+        "custom/linear-trend-unknown.bin".to_owned(),
+        vec![0, 255, 7],
+    ));
+    ooxml_opc::rezip_parts(&parts).unwrap()
+}
+
+fn frame(book: &Workbook) -> DisplayList {
+    book.display_list_for(
+        SheetId(0),
+        &Viewport {
+            x: 0.0,
+            y: 0.0,
+            width: 1100.0,
+            height: 800.0,
+        },
+    )
+    .unwrap()
+}
+
+fn trend(frame: &DisplayList) -> Vec<(f32, f32, f32, f32)> {
+    frame
+        .commands
+        .iter()
+        .filter_map(|command| match command {
+            DrawCmd::Line {
+                x1,
+                y1,
+                x2,
+                y2,
+                color,
+                ..
+            } if color.as_ref().eq_ignore_ascii_case("#ff00ee") => Some((*x1, *y1, *x2, *y2)),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn real_chart_parse_screen_print_edit_undo_and_save_reopen_agree() {
+    for scatter in [false, true] {
+        let bytes = fixture(scatter);
+        let mut book = Workbook::open(&bytes).unwrap();
+        let version = book.version();
+        let history = book.history_state();
+        let original = trend(&frame(&book));
+        assert_eq!(original.len(), 1);
+        assert!(original[0].1 > original[0].3);
+        assert_eq!(book.version(), version);
+        assert_eq!(book.history_state(), history);
+        let print = book
+            .print_display_list(
+                SheetId(0),
+                CellRange {
+                    start: at(0, 0),
+                    end: at(50, 30),
+                },
+                &PrintMetrics {
+                    dpi: 96.0,
+                    max_digit_width: 7.0,
+                    default_row_height_pt: 15.0,
+                    default_column_width: None,
+                    font_size_pt: 11.0,
+                    font_family: "Calibri".to_owned(),
+                    font_ascent: 10.0,
+                    font_descent: 3.0,
+                },
+                false,
+            )
+            .unwrap();
+        assert_eq!(trend(&print).len(), 1);
+        book.edit_cell(SheetId(0), at(1, 1), "8", CalculationOptions::default())
+            .unwrap();
+        assert_ne!(trend(&frame(&book)), original);
+        book.undo(CalculationOptions::default()).unwrap();
+        assert_eq!(trend(&frame(&book)), original);
+        let saved = book.save().unwrap();
+        let reopened = Workbook::open(&saved).unwrap();
+        assert_eq!(trend(&frame(&reopened)), original);
+        let before = ooxml_opc::unzip_parts(&bytes).unwrap();
+        let after = ooxml_opc::unzip_parts(&saved).unwrap();
+        for path in [CHART, "custom/linear-trend-unknown.bin"] {
+            assert_eq!(
+                before.iter().find(|(name, _)| name == path).unwrap().1,
+                after.iter().find(|(name, _)| name == path).unwrap().1
+            );
+        }
+    }
+}
