+use betteroffice_xlsx::{CalculationOptions,CellRef,SheetId,Workbook,Op};
+use xlsx_model::{CellValue,CellRange};
+const MAIN:&str="http://schemas.openxmlformats.org/spreadsheetml/2006/main";
+const REL:&str="http://schemas.openxmlformats.org/officeDocument/2006/relationships";
+fn options()->CalculationOptions{CalculationOptions::default()}
+fn source()->Vec<u8>{
+    let parts=vec![
+        ("[Content_Types].xml",format!(r#"<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/tables/table1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml"/></Types>"#)),
+        ("_rels/.rels",format!(r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="book" Type="{REL}/officeDocument" Target="xl/workbook.xml"/></Relationships>"#)),
+        ("xl/workbook.xml",format!(r#"<workbook xmlns="{MAIN}" xmlns:r="{REL}"><sheets><sheet name="Data" sheetId="1" r:id="sheet"/></sheets></workbook>"#)),
+        ("xl/_rels/workbook.xml.rels",format!(r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="sheet" Type="{REL}/worksheet" Target="worksheets/sheet1.xml"/></Relationships>"#)),
+        ("xl/worksheets/sheet1.xml",format!(r#"<worksheet xmlns="{MAIN}" xmlns:r="{REL}"><sheetData><row r="1"><c r="A1" t="inlineStr"><is><t>Item</t></is></c><c r="B1" t="inlineStr"><is><t>Amount</t></is></c><c r="D1"><f>SUM(Sales[Amount])</f><v>3</v></c></row><row r="2"><c r="A2" t="inlineStr"><is><t>One</t></is></c><c r="B2"><v>1</v></c></row><row r="3"><c r="A3" t="inlineStr"><is><t>Two</t></is></c><c r="B3"><v>2</v></c></row></sheetData><tableParts count="1"><tablePart r:id="table"/></tableParts></worksheet>"#)),
+        ("xl/worksheets/_rels/sheet1.xml.rels",format!(r#"<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="table" Type="{REL}/table" Target="../tables/table1.xml"/></Relationships>"#)),
+        ("xl/tables/table1.xml",format!(r#"<table xmlns="{MAIN}" id="1" name="Sales" displayName="Sales" ref="A1:B3" headerRowCount="1" totalsRowCount="0"><autoFilter ref="A1:B3"/><tableColumns count="2"><tableColumn id="4" name="Item" totalsRowLabel="Keep"/><tableColumn id="9" name="Amount"><extLst><ext uri="column-vendor"/></extLst></tableColumn></tableColumns><tableStyleInfo name="TableStyleMedium2" showRowStripes="1"/><extLst><ext uri="table-vendor"/></extLst></table>"#)),
+        ("customXml/vendor.xml","<keep>table-test</keep>".into()),
+    ];
+    ooxml_opc::rezip_parts(&parts.into_iter().map(|(n,s)|(n.to_owned(),s.into_bytes())).collect::<Vec<_>>()).unwrap()
+}
+fn range(w:&Workbook)->String{w.model().tables[0].range.to_a1()}
+fn sum(w:&Workbook)->f64{match w.model().sheet(SheetId(0)).unwrap().cell(CellRef::new(0,3)).unwrap().value{CellValue::Number{value}=>value,_=>panic!("sum is not numeric")}}
+fn xml(bytes:&[u8],path:&str)->String{
+    let parts=ooxml_opc::unzip_parts(bytes).unwrap();
+    String::from_utf8(parts.into_iter().find(|(name,_)|name==path).unwrap().1).unwrap()
+}
+#[test]
+fn rows_grow_and_structured_sum_recalculates_with_single_undo_redo(){
+    let mut w=Workbook::open(&source()).unwrap();
+    w.edit_cell(SheetId(0),CellRef::new(3,1),"4",options()).unwrap();
+    assert_eq!(range(&w),"A1:B4");assert_eq!(sum(&w),7.0);
+    w.undo(options()).unwrap();assert_eq!(range(&w),"A1:B3");assert_eq!(sum(&w),3.0);
+    w.redo(options()).unwrap();assert_eq!(range(&w),"A1:B4");assert_eq!(sum(&w),7.0);
+    let saved=w.save().unwrap();let reopened=Workbook::open(&saved).unwrap();
+    assert_eq!(range(&reopened),"A1:B4");assert_eq!(sum(&reopened),7.0);
+    let table=xml(&saved,"xl/tables/table1.xml");assert!(table.contains("table-vendor"));assert!(table.contains("column-vendor"));assert!(table.contains("TableStyleMedium2"));
+    assert_eq!(xml(&saved,"customXml/vendor.xml"),"<keep>table-test</keep>");
+}
+#[test]
+fn columns_grow_from_header_input_with_unique_ids_and_preserved_metadata(){
+    let mut w=Workbook::open(&source()).unwrap();
+    w.edit_cell(SheetId(0),CellRef::new(0,2),"Cost",options()).unwrap();
+    assert_eq!(range(&w),"A1:C3");assert_eq!(w.model().tables[0].columns,vec!["Item","Amount","Cost"]);
+    let saved=w.save().unwrap();let table=xml(&saved,"xl/tables/table1.xml");
+    assert!(table.contains("id=\"10\""));assert!(table.contains("column-vendor"));assert!(table.contains("totalsRowLabel=\"Keep\""));
+    let reopened=Workbook::open(&saved).unwrap();assert_eq!(reopened.model().tables[0].columns,w.model().tables[0].columns);
+    w.undo(options()).unwrap();assert_eq!(range(&w),"A1:B3");
+    w.redo(options()).unwrap();assert_eq!(range(&w),"A1:C3");
+}
+#[test]
+fn insert_and_delete_body_rows_move_table_and_keep_structured_formulas(){
+    let mut w=Workbook::open(&source()).unwrap();
+    w.apply_ops(vec![Op::InsertRows{sheet:SheetId(0),at:2,count:1}],options()).unwrap();
+    assert_eq!(range(&w),"A1:B4");assert_eq!(sum(&w),3.0);
+    w.edit_cell(SheetId(0),CellRef::new(2,1),"10",options()).unwrap();assert_eq!(sum(&w),13.0);
+    w.undo(options()).unwrap();w.undo(options()).unwrap();assert_eq!(range(&w),"A1:B3");assert_eq!(sum(&w),3.0);
+    w.apply_ops(vec![Op::DeleteRows{sheet:SheetId(0),at:1,count:1}],options()).unwrap();assert_eq!(range(&w),"A1:B2");assert_eq!(sum(&w),2.0);
+    w.undo(options()).unwrap();assert_eq!(range(&w),"A1:B3");assert_eq!(sum(&w),3.0);
+}
+#[test]
+fn invalid_resize_refuses_a_whole_mixed_batch(){
+    let mut w=Workbook::open(&source()).unwrap();let before=w.save().unwrap();
+    let mut tables=w.model().tables.clone();tables[0].range=CellRange::parse_a1("A1:C3").unwrap();
+    let op=Op::SetCell{sheet:SheetId(0),at:CellRef::new(8,0),cell:xlsx_ops::CellState{value:CellValue::Number{value:99.0},..Default::default()}};
+    assert!(w.apply_ops(vec![op,Op::SetTables{tables}],options()).is_err());assert_eq!(w.save().unwrap(),before);
+}
+#[test]
+fn clearing_adjacent_cell_does_not_expand_a_table(){
+    let mut w=Workbook::open(&source()).unwrap();w.edit_cell(SheetId(0),CellRef::new(3,1),"",options()).unwrap();assert_eq!(range(&w),"A1:B3");
+}
