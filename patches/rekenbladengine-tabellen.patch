new file mode 100644
index 0000000..82a616d
--- /dev/null
+++ b/crates/xlsx-ops/src/tables.rs
@@ -0,0 +1,125 @@
+//! Undoable table geometry and automatic growth; package presentation remains in OOXML.
+use std::collections::HashSet;
+use xlsx_model::{CellRange, CellRef, CellValue, SheetId, Table, Workbook};
+use xlsx_model::addr::{MAX_COLS,MAX_ROWS};
+use crate::{CellState,Op,OpError};
+
+const MAX_EXPANSION_CELLS:u64=100_000;
+fn invalid(message:&str)->OpError {OpError::InvalidTable(message.into())}
+
+pub fn validate_tables(wb:&Workbook,tables:&[Table])->Result<(),OpError>{
+    if tables.len()>65536{return Err(invalid("too many tables"));}
+    let mut names=HashSet::new();
+    for (i,t) in tables.iter().enumerate(){
+        if wb.sheet(t.sheet).is_none(){return Err(OpError::SheetNotFound(t.sheet));}
+        let r=t.range;
+        if r.start.row>r.end.row||r.start.col>r.end.col||r.end.row>=MAX_ROWS||r.end.col>=MAX_COLS{return Err(invalid("table outside worksheet grid"));}
+        if t.name.is_empty()||t.name.len()>1024||!names.insert(t.name.to_ascii_lowercase()){return Err(invalid("invalid or duplicate table name"));}
+        let rows=r.end.row-r.start.row+1;
+        if t.header_rows>1||t.totals_rows>1||t.header_rows+t.totals_rows>rows||t.columns.len()!=(r.end.col-r.start.col+1) as usize{return Err(invalid("table columns or header/totals bands do not match its range"));}
+        let mut columns=HashSet::new();
+        for name in &t.columns {
+            if name.is_empty()||name.chars().count()>255||!columns.insert(name.to_lowercase()){return Err(invalid("invalid or duplicate table column name"));}
+        }
+        if tables[..i].iter().any(|other|other.sheet==t.sheet&&other.range.overlaps(&t.range)){return Err(invalid("table ranges overlap"));}
+    }
+    Ok(())
+}
+fn has_input(cell:&CellState)->bool {cell.formula.is_some()||!matches!(cell.value,CellValue::Empty)}
+fn adjacent(t:&Table,sheet:SheetId,at:CellRef)->bool {
+    t.sheet==sheet&&((t.totals_rows==0&&at.row==t.range.end.row.saturating_add(1)&&at.col>=t.range.start.col&&at.col<=t.range.end.col)
+        ||(at.col==t.range.end.col.saturating_add(1)&&at.row>=t.range.start.row&&at.row<=t.range.end.row))
+}
+pub fn table_input_may_expand(wb:&Workbook,ops:&[Op])->bool {
+    ops.iter().any(|op|match op{Op::SetCell{sheet,at,cell}=>has_input(cell)&&wb.tables.iter().any(|t|adjacent(t,*sheet,*at)),_=>false})
+}
+fn unique_column(columns:&[String],preferred:Option<String>)->String {
+    if let Some(s)=preferred.filter(|s|!s.is_empty()&&s.chars().count()<=255) {
+        if !columns.iter().any(|v|v.eq_ignore_ascii_case(&s)){return s;}
+    }
+    let mut i=columns.len()+1;
+    loop {let s=format!("Column{i}");if !columns.iter().any(|v|v.eq_ignore_ascii_case(&s)){return s;}i+=1;}
+}
+/// Called only while staging an atomic edit. Returns cell/style and table inverses.
+pub(crate) fn grow_for_cell(wb:&mut Workbook,sheet:SheetId,at:CellRef,cell:&CellState)->Result<Vec<Op>,OpError>{
+    if !has_input(cell){return Ok(Vec::new());}
+    if wb.tables.iter().any(|t|t.sheet==sheet&&at.row>=t.range.start.row&&at.row<=t.range.end.row&&at.col>=t.range.start.col&&at.col<=t.range.end.col){return Ok(Vec::new());}
+    let indices=wb.tables.iter().enumerate().filter_map(|(i,t)|adjacent(t,sheet,at).then_some(i)).collect::<Vec<_>>();
+    if indices.is_empty(){return Ok(Vec::new());}
+    if indices.len()!=1{return Err(invalid("input is adjacent to more than one table"));}
+    let old=wb.tables.clone();let index=indices[0];let mut next=old[index].clone();
+    let column=at.col>next.range.end.col;
+    let count=if column{(next.range.end.row-next.range.start.row+1)as u64}else{(next.range.end.col-next.range.start.col+1)as u64};
+    if count>MAX_EXPANSION_CELLS{return Err(invalid("table expansion exceeds 100000 cells"));}
+    if column {
+        next.range.end.col=at.col;
+        let header=CellRef::new(next.range.start.row,at.col);
+        let preferred=if at.row==header.row{match &cell.value{CellValue::Text{value}=>Some(value.clone()),_=>None}}else{wb.sheet(sheet).and_then(|s|s.cell(header)).and_then(|c|match &c.value{CellValue::Text{value}=>Some(value.clone()),_=>None})};
+        next.columns.push(unique_column(&next.columns,preferred));
+    }else{next.range.end.row=at.row;}
+    let mut tables=old.clone();tables[index]=next.clone();validate_tables(wb,&tables)?;
+    wb.tables=tables;
+    let mut inverse=Vec::new();
+    let cells=if column{(next.range.start.row..=next.range.end.row).map(|row|CellRef::new(row,at.col)).collect::<Vec<_>>()}else{(next.range.start.col..=next.range.end.col).map(|col|CellRef::new(at.row,col)).collect::<Vec<_>>()};
+    let s=wb.sheet_mut(sheet).ok_or(OpError::SheetNotFound(sheet))?;
+    for target in cells {
+        let current=s.cell(target).cloned().unwrap_or_default();
+        let source=if column{CellRef::new(target.row,target.col-1)}else{CellRef::new(target.row.saturating_sub(if target.row>next.range.start.row+2{2}else{1}),target.col)};
+        let style=s.cell(source).and_then(|c|c.style);
+        let mut updated=current.clone();
+        if updated.style.is_none(){updated.style=style;}
+        if column&&next.header_rows>0&&target.row==next.range.start.row&&target!=at&&matches!(updated.value,CellValue::Empty)&&updated.formula.is_none(){updated.value=CellValue::Text{value:next.columns.last().unwrap().clone()};}
+        if updated!=current {
+            inverse.push(Op::SetCell{sheet,at:target,cell:CellState::from(&current)});
+            s.set_cell(target,updated);
+        }
+    }
+    inverse.push(Op::SetTables{tables:old});
+    Ok(inverse)
+}
+
+/// Structural edits move table geometry along with cells. Whole-table deletion
+/// is explicit (convert to range first), avoiding orphaned source relationships.
+pub(crate) fn remap_tables(wb:&mut Workbook,op:&Op)->Result<Vec<Op>,OpError>{
+    let (sheet,at,count,rows,insert)=match *op{
+        Op::InsertRows{sheet,at,count}=>(sheet,at,count,true,true),
+        Op::DeleteRows{sheet,at,count}=>(sheet,at,count,true,false),
+        Op::InsertCols{sheet,at,count}=>(sheet,at,count,false,true),
+        Op::DeleteCols{sheet,at,count}=>(sheet,at,count,false,false),
+        _=>return Ok(Vec::new()),
+    };
+    if count==0{return Ok(Vec::new());}
+    let old=wb.tables.clone();let mut tables=old.clone();
+    for t in tables.iter_mut().filter(|t|t.sheet==sheet){
+        let (start,end)=if rows{(t.range.start.row,t.range.end.row)}else{(t.range.start.col,t.range.end.col)};
+        if at>end{continue;}
+        let (new_start,new_end)=if insert {
+            let a=if at<=start{start.checked_add(count)}else{Some(start)};
+            let b=end.checked_add(count);
+            (a,b)
+        }else{
+            let stop=at.saturating_add(count);
+            if at<=start&&stop>end{return Err(invalid("convert the table to a range before deleting its whole extent"));}
+            if rows&&((t.header_rows>0&&at<=start&&stop>start)||(t.totals_rows>0&&at<=end&&stop>end)){return Err(invalid("disable table headers/totals before deleting that band"));}
+            let a=if start>=stop{start-count}else if start>=at{at}else{start};
+            let b=if end>=stop{end-count}else if end>=at{at.saturating_sub(1)}else{end};
+            (Some(a),Some(b))
+        };
+        let (Some(a),Some(b))=(new_start,new_end)else{return Err(invalid("table shift exceeds worksheet grid"));};
+        if b>=if rows{MAX_ROWS}else{MAX_COLS}{return Err(invalid("table shift exceeds worksheet grid"));}
+        if rows{t.range=CellRange::new(CellRef::new(a,t.range.start.col),CellRef::new(b,t.range.end.col));}
+        else{
+            if insert&&at>start {
+                let index=(at-start)as usize;
+                for n in 0..count as usize{let name=unique_column(&t.columns,None);t.columns.insert(index+n,name);}
+            }else if !insert {
+                let first=at.max(start)-start;let last=at.saturating_add(count).min(end+1)-start;
+                if first<last{t.columns.drain(first as usize..last as usize);}
+            }
+            t.range=CellRange::new(CellRef::new(t.range.start.row,a),CellRef::new(t.range.end.row,b));
+        }
+    }
+    if tables==old{return Ok(Vec::new());}
+    validate_tables(wb,&tables)?;wb.tables=tables;
+    Ok(vec![Op::SetTables{tables:old}])
+}
