+//! Patch only changed existing table geometry; preserve source table/style/column extensions.
+use super::*;
+
+fn value(bytes:&[u8],name:&str)->Result<Option<String>,ParseError>{
+    Ok(attributes_from_fragment(bytes)?.into_iter().find(|a|a.local_name()==name).map(|a|a.value))
+}
+pub(super) fn patch(wb:&Workbook,package:&PreservedPackage,sheets:&[PlannedSheet],parts:&mut PartStore<'_>)->Result<(),ParseError>{
+    if wb.tables==package.original_workbook.tables{return Ok(());}
+    let mut seen=HashSet::new();
+    for (index,sheet) in sheets.iter().enumerate(){
+        let rel_path=relationship_part_path(&sheet.path);
+        let Some(rels)=parts.get(&rel_path)else{continue;};
+        for rel in parse_relationships(rels)?.into_iter().filter(|r|r.has_type("table")){
+            if rel.attribute("TargetMode").is_some_and(|v|v.eq_ignore_ascii_case("external")){continue;}
+            let Some(target)=rel.target()else{continue;};
+            let base=sheet.path.rsplit_once('/').map_or("",|(base,_)|base);
+            let path=resolve_part_path(base,target);
+            let source=parts.get(&path).ok_or_else(||ParseError::Malformed("missing table part".into()))?;
+            let name=value(source,"displayName")?.or(value(source,"name")?).ok_or_else(||ParseError::Malformed("table without name".into()))?;
+            let Some(table)=wb.tables.iter().find(|t|t.sheet==SheetId(index as u32)&&t.name==crate::read::unescape_name(&name))else{continue;};
+            let old=sheet.origin.and_then(|origin|package.original_workbook.tables.iter().find(|t|t.sheet==SheetId(origin as u32)&&t.name==table.name));
+            if old.is_some_and(|old|old.range==table.range&&old.columns==table.columns&&old.header_rows==table.header_rows&&old.totals_rows==table.totals_rows){continue;}
+            if !seen.insert(path.clone()){return Err(ParseError::UnsupportedEdit("shared table part cannot be resized".into()));}
+            let xml=resize(source,table)?;
+            parts.set(path,xml)?;
+        }
+    }
+    Ok(())
+}
+fn resize(source:&[u8],table:&xlsx_model::Table)->Result<Vec<u8>,ParseError>{
+    let root=XmlTemplate::capture(source)?;
+    root.require_unwrapped_child("tableColumns")?;root.require_unwrapped_child("autoFilter")?;
+    let columns=root.child("tableColumns").ok_or_else(||ParseError::Malformed("table without columns".into()))?;
+    let ct=root.capture_child(columns)?;
+    let original=ct.children_named("tableColumn").collect::<Vec<_>>();
+    let mut next_id=0u32;
+    for column in &original{next_id=next_id.max(value(&column.bytes,"id")?.and_then(|s|s.parse().ok()).unwrap_or(0));}
+    let mut output=Vec::with_capacity(table.columns.len());
+    for name in &table.columns{
+        let existing=original.iter().find(|c|value(&c.bytes,"name").ok().flatten().is_some_and(|s|crate::read::unescape_name(&s)==*name));
+        if let Some(column)=existing{output.push(column.bytes.clone());}
+        else{
+            next_id=next_id.checked_add(1).ok_or_else(||ParseError::Malformed("table column ids exhausted".into()))?;
+            let mut w=Writer::new(Vec::new());let mut e=BytesStart::new("tableColumn");
+            let id=next_id.to_string();e.push_attribute(("xmlns",root.root_namespace().unwrap_or(NS_MAIN)));e.push_attribute(("id",id.as_str()));e.push_attribute(("name",name.as_str()));
+            w.write_event(Event::Empty(e)).map_err(xml_err)?;output.push(w.into_inner());
+        }
+    }
+    let columns=ct.render_repeated("tableColumn",&output,&[("count",table.columns.len().to_string())])?;
+    let mut replacements=vec![("tableColumns",Some(columns))];
+    if let Some(filter)=root.child("autoFilter"){
+        let ft=root.capture_child(filter)?;
+        let mut range=table.range;range.end.row=range.end.row.saturating_sub(table.totals_rows);
+        replacements.push(("autoFilter",Some(ft.render_with_attributes(Vec::new(),|_|0,&[("ref",Some(range.to_a1()))])?)));
+    }
+    root.render_with_attributes(replacements,|name|match name{"autoFilter"=>0,"sortState"=>1,"tableColumns"=>2,"tableStyleInfo"=>3,_=>4},&[("ref",Some(table.range.to_a1())),("headerRowCount",Some(table.header_rows.to_string())),("totalsRowCount",Some(table.totals_rows.to_string()))])
+}
